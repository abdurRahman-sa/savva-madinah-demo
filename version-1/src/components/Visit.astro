---
import { Picture } from 'astro:assets';
import terrace from '../assets/photos/terrace-day.jpg';
import drive from '../assets/photos/drive-through-tray.jpg';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const v = t.visit;
---

<section id="visit" class="bg-cream">
  <div class="container-page py-20 lg:py-28">
    <p class="eyebrow">{v.eyebrow}</p>
    <h2 class="h-display h-section mt-4">{v.title}</h2>

    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <div class="rounded-3xl bg-sand p-7 sm:p-9 lg:col-span-4">
        <div class="flex items-center gap-3 text-ink">
          <Icon name="clock" class="size-5 text-sage-deep" />
          <h3 class="font-semibold">{v.hoursTitle}</h3>
        </div>
        <OpenStatus t={t} class="mt-5 rounded-full bg-cream px-4 py-2 text-sm text-ink ring-1 ring-line" />
        <ul class="mt-6 divide-y divide-line text-[0.95rem] text-muted">
          {
            v.days.map((row) => (
              <li class="flex items-center justify-between gap-4 py-3" data-hours-day={row.day}>
                <span class="flex items-center gap-2">
                  {row.label}
                  <span class="today-badge rounded-full bg-sage-soft px-2 py-0.5 text-xs font-medium text-sage-deep">{v.today}</span>
                </span>
                <span class="whitespace-nowrap tabular-nums">{row.range}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col rounded-3xl bg-sand p-7 sm:p-9 lg:col-span-4">
        <div class="flex items-center gap-3 text-ink">
          <Icon name="pin" class="size-5 text-sage-deep" />
          <h3 class="font-semibold">{v.addressTitle}</h3>
        </div>
        <address class="mt-5 text-lg leading-relaxed text-ink not-italic">
          {v.address.map((line) => <span class="block">{line}</span>)}
        </address>
        <p class="mt-2 text-sm text-muted" dir="ltr">{v.plusCode}</p>

        <div class="mt-8 flex flex-col gap-3">
          <a href={cafe.mapsUrl} target="_blank" rel="noopener" class="btn-primary">
            {v.route}
            <Icon name="arrow" class="size-4 rtl:-scale-x-100" />
          </a>
          <a href={cafe.phoneHref} class="btn-secondary">
            <Icon name="phone" class="size-4" />
            <span dir="ltr">{cafe.phone}</span>
          </a>
        </div>

        <a
          href={cafe.instagramUrl}
          target="_blank"
          rel="noopener"
          class="mt-auto inline-flex items-center gap-2 pt-8 font-medium text-sage-deep transition-colors hover:text-ink"
        >
          <Icon name="instagram" class="size-5" />
          <span dir="ltr">{cafe.instagramHandle}</span>
        </a>
      </div>

      <figure class="flex flex-col lg:col-span-4">
        <div class="relative aspect-[4/5] overflow-hidden rounded-t-full bg-sand lg:aspect-auto lg:min-h-[24rem] lg:flex-1">
          <Picture
            src={terrace}
            formats={['avif', 'webp']}
            widths={[480, 720, 1080]}
            sizes="(min-width: 1024px) 26rem, 92vw"
            alt={v.terrace.alt}
            class="h-full w-full object-cover object-top"
            pictureAttributes={{ class: 'absolute inset-0 block' }}
          />
        </div>
        <figcaption class="photo-caption">{v.terrace.caption}</figcaption>
      </figure>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-12">
      <figure class="relative aspect-square overflow-hidden rounded-3xl bg-sand lg:col-span-5 lg:aspect-auto lg:min-h-[26rem]">
        <Picture
          src={drive}
          formats={['avif', 'webp']}
          widths={[400, 518]}
          sizes="(min-width: 1024px) 32rem, 92vw"
          alt={v.drive.alt}
          class="h-full w-full object-cover object-[center_35%]"
          pictureAttributes={{ class: 'absolute inset-0 block' }}
        />
        <figcaption class="absolute inset-x-4 bottom-4 rounded-2xl bg-cream px-5 py-4 text-sm text-ink">
          {v.drive.caption}
        </figcaption>
      </figure>

      <div class="flex flex-col justify-center rounded-3xl bg-sage-deep p-7 text-cream sm:p-10 lg:col-span-7">
        <h3 class="h-display text-3xl text-cream">{v.formatsTitle}</h3>
        <ul class="mt-8 grid gap-8">
          {
            v.formats.map((format) => (
              <li class="flex gap-5">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-cream/10 text-cream">
                  <Icon name={format.icon} class="size-6" />
                </span>
                <span>
                  <span class="block text-lg font-semibold">{format.title}</span>
                  <span class="mt-1 block leading-relaxed text-cream/75">{format.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
