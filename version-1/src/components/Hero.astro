---
import { Picture } from 'astro:assets';
import facade from '../assets/photos/facade-night.jpg';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="container-page grid items-center gap-14 pt-10 pb-20 lg:grid-cols-12 lg:gap-10 lg:pt-16 lg:pb-28">
    <div class="lg:col-span-7">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="h-display h-hero mt-5 max-w-[14ch] text-ink">{t.hero.title}</h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">{t.hero.lead}</p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#menu" class="btn-primary">{t.hero.ctaMenu}</a>
        <a href="#booking" class="btn-secondary">{t.hero.ctaBooking}</a>
      </div>

      <ul class="mt-11 flex flex-wrap gap-2">
        {
          t.hero.chips.map((chip) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-sand px-3.5 py-2 text-sm text-ink">
              <Icon name={chip.icon} class="size-4 text-sage-deep" />
              {chip.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative lg:col-span-5">
      <div class="absolute top-1/2 left-1/2 -z-10 size-[min(34rem,120vw)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-sage-soft/70" aria-hidden="true"></div>

      <div class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-t-full bg-sand">
        <Picture
          src={facade}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 28rem, (min-width: 480px) 28rem, 90vw"
          alt={t.hero.photo.alt}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
      </div>

      <div class="absolute end-0 top-6 rounded-full bg-cream/95 px-4 py-2.5 text-sm text-ink shadow-[0_12px_40px_-16px_rgb(38_37_31/0.35)] ring-1 ring-line sm:end-2 lg:-end-4">
        <OpenStatus t={t} />
      </div>

      <div class="absolute start-0 -bottom-6 flex items-center gap-4 rounded-2xl bg-cream/95 px-5 py-4 shadow-[0_18px_50px_-18px_rgb(38_37_31/0.35)] ring-1 ring-line sm:start-2 lg:-start-8">
        <span class="font-brand text-5xl leading-none font-semibold text-ink" dir="ltr">{cafe.rating}</span>
        <span>
          <span class="flex gap-0.5 text-coffee" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
          </span>
          <span class="mt-1 block text-sm text-muted">{t.hero.ratingLabel}</span>
        </span>
      </div>
    </div>
  </div>
</section>
