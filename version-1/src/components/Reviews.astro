---
import Icon from './Icon.astro';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const r = t.reviews;
---

<section id="reviews" class="bg-sand">
  <div class="container-page grid gap-14 py-20 lg:grid-cols-12 lg:gap-12 lg:py-28">
    <div class="lg:col-span-4">
      <p class="eyebrow">{r.eyebrow}</p>
      <h2 class="h-display h-section mt-4">{r.title}</h2>

      <div class="mt-10 flex items-center gap-5">
        <span class="font-brand text-7xl leading-none font-semibold text-ink" dir="ltr">{cafe.rating}</span>
        <div>
          <span class="flex gap-0.5 text-coffee" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-5" />)}
          </span>
          <p class="mt-1.5 text-sm text-muted">
            <span class="sr-only">{cafe.rating} {r.outOf}. </span>{r.ratingLabel}
          </p>
        </div>
      </div>

      <p class="mt-10 text-sm font-medium text-ink">{r.tagsTitle}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          r.tags.map((tag) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-cream px-3.5 py-2 text-sm text-ink ring-1 ring-line">
              {tag.label}
              <span class="text-muted tabular-nums">{tag.count}</span>
            </li>
          ))
        }
      </ul>

      <a
        href={cafe.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-10 inline-flex items-center gap-2 font-medium text-sage-deep underline decoration-sage/40 underline-offset-4 transition-colors hover:text-ink"
      >
        {r.link}
        <Icon name="arrow" class="size-4 rtl:-scale-x-100" />
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:col-span-8">
      {
        r.quotes.map((quote, index) => (
          <figure class:list={['flex flex-col justify-between rounded-3xl bg-cream p-7 sm:p-9', index === 0 && 'md:col-span-2']}>
            <blockquote>
              <p
                class:list={[
                  'text-ink',
                  quote.text.length < 40
                    ? 'h-display text-3xl md:text-4xl'
                    : index === 0
                      ? 'text-lg leading-relaxed md:text-xl'
                      : 'text-base leading-relaxed',
                ]}
              >
                «{quote.text}»
              </p>
            </blockquote>
            <figcaption class="mt-8 flex items-center justify-between gap-4 border-t border-line pt-5">
              <span class="font-medium text-ink" dir="auto">
                {quote.author}
              </span>
              <span class="text-end text-xs text-muted">{quote.source}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
