---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Atmosphere from './Atmosphere.astro';
import Signature from './Signature.astro';
import Menu from './Menu.astro';
import Booking from './Booking.astro';
import Reviews from './Reviews.astro';
import Visit from './Visit.astro';
import Footer from './Footer.astro';
import MobileBar from './MobileBar.astro';
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<Layout t={t}>
  <Header t={t} />
  <main>
    <Hero t={t} />
    <Atmosphere t={t} />
    <Signature t={t} />
    <Menu t={t} />
    <Booking t={t} />
    <Reviews t={t} />
    <Visit t={t} />
  </main>
  <Footer t={t} />
  <MobileBar t={t} />
</Layout>
