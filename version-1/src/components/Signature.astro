---
import { Picture } from 'astro:assets';
import cookies from '../assets/photos/madini-cookies-close.jpg';
import hibiscus from '../assets/photos/hibiscus-pour.jpg';
import matcha from '../assets/photos/matcha-berry-vs-melon.jpg';
import cheesecake from '../assets/photos/blueberry-cheesecake.jpg';
import type { Dict, SignatureKey } from '../i18n/types';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const s = t.signature;
const images: Record<SignatureKey, ImageMetadata> = { cookies, hibiscus, matcha, cheesecake };
// На фото матчи сверху зашита подпись из рилса — кадрируем по нижнему краю
const positions: Partial<Record<SignatureKey, string>> = { matcha: 'object-bottom' };
---

<section id="signature" class="bg-cream">
  <div class="container-page py-20 lg:py-28">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">{s.eyebrow}</p>
        <h2 class="h-display h-section mt-4">{s.title}</h2>
      </div>
      <p class="max-w-sm text-muted md:text-end">{s.intro}</p>
    </div>

    <div class="mt-14 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.items.map((item) => (
          <article>
            <div class="aspect-[3/4] overflow-hidden rounded-t-full bg-sand">
              <Picture
                src={images[item.key]}
                formats={['avif', 'webp']}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 18rem, (min-width: 640px) 45vw, 90vw"
                alt={item.alt}
                class={`h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03] ${positions[item.key] ?? ''}`}
                pictureAttributes={{ class: 'block h-full w-full' }}
              />
            </div>
            <div class="mt-6 flex items-baseline justify-between gap-4">
              <h3 class="h-display h-card">{item.title}</h3>
              {item.price && <span class="shrink-0 font-medium whitespace-nowrap text-coffee tabular-nums">{item.price}</span>}
            </div>
            <p class="mt-1 text-xs tracking-wider text-muted uppercase" dir="ltr" lang="en">
              {item.original}
            </p>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
            {item.note && (
              <p class="mt-4 inline-flex rounded-full bg-sage-soft px-3 py-1 text-xs font-medium text-sage-deep">{item.note}</p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
