---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Fork from '../components/Fork.astro';
import Fresh from '../components/Fresh.astro';
import CalmMenu from '../components/CalmMenu.astro';
import Reviews from '../components/Reviews.astro';
import Footer from '../components/Footer.astro';
import { ru as t } from '../i18n/ru';
---

<Layout t={t}>
  <main>
    <Hero t={t} />
    <Fork t={t} />
    <Fresh t={t} />
    <CalmMenu t={t} />
    <Reviews t={t} />
  </main>
  <Footer t={t} />
</Layout>
