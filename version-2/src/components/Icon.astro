---
import { icons } from './icon-sets';

// Иконки сайта — Phosphor Duotone: контур и лёгкая заливка тем же цветом, рисуются от currentColor.
interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" set:html={icons[name]} />
