---
import Icon from './Icon.astro';
import type { Dict } from '../i18n/ru';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.cart;
---

<!-- Плавающая кнопка заказа: видна, когда в корзине что-то есть; ведёт в «Заказать» развилки -->
<a class="cart-fab" href="#fork" data-open-door="order" data-cart-fab hidden aria-label={c.fabLabel}>
  <Icon name="bag" class="bag" />
  <span class="label">{c.fab}</span>
  <b class="count" data-fab-count>0</b>
  <span class="sum" data-fab-sum></span>
</a>

<style>
  .cart-fab {
    position: fixed;
    z-index: 39;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 14px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 10px 26px -14px rgb(35 30 25 / 0.7);
    transition:
      bottom calc(0.35s * var(--motion)) var(--ease),
      background-color 0.2s var(--ease-out-expo);
  }
  .cart-fab[hidden] {
    display: none;
  }
  .cart-fab:hover {
    background: var(--color-red-ink);
  }
  .cart-fab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .cart-fab :global(.bag) {
    width: 22px;
    height: 22px;
  }
  .count {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    padding-inline: 6px;
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-red-ink);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .sum {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .sum:empty {
    display: none;
  }

  /* пока идёт заставка, кнопка не мешает */
  :global(body:has([data-hero]:not([data-intro='done']))) .cart-fab {
    opacity: 0;
    pointer-events: none;
  }
  /* кнопка «Твики» (только на dev-сервере) стоит в том же углу — поднимаемся над ней */
  :global(body:has([data-tweaks-open])) .cart-fab {
    bottom: calc(max(16px, env(safe-area-inset-bottom)) + 52px);
  }
  /* на телефоне статус работы слева внизу во всю ширину не влезает рядом — встаём над ним */
  @media (max-width: 720px) {
    .cart-fab {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 56px);
    }
    .label {
      display: none;
    }
    :global(body:has([data-action-bar][data-state='shown'])) .cart-fab {
      bottom: calc(146px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-fab {
      transition: none;
    }
  }
</style>

<script>
  import { cartTotals, onCart } from '../scripts/cart';

  const fab = document.querySelector<HTMLElement>('[data-cart-fab]');
  if (fab) {
    const paint = () => {
      const { count, sum } = cartTotals();
      fab.hidden = count === 0;
      fab.querySelector('[data-fab-count]')!.textContent = String(count);
      fab.querySelector('[data-fab-sum]')!.textContent = sum ? `${sum} SAR` : '';
    };
    onCart(paint);
    paint();
  }
</script>
