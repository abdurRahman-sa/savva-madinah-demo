---
import Icon from './Icon.astro';
import type { Dict } from '../i18n/ru';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.cart;
---

<!-- Плавающая кнопка заказа открывает корзину; переход к способу получения гость выбирает уже внутри. -->
<button class="cart-fab" type="button" data-cart-fab hidden aria-label={c.fabLabel} aria-haspopup="dialog" aria-controls="cart-dialog">
  <Icon name="bag" class="bag" />
  <span class="label">{c.fab}</span>
  <b class="count" data-fab-count>0</b>
  <span class="sum" data-fab-sum></span>
</button>

<dialog
  class="cart-dialog"
  id="cart-dialog"
  data-cart-dialog
  data-total={c.total}
  data-at-counter={c.atCounter}
  data-plus-counter={c.plusCounter}
  aria-labelledby="cart-dialog-title"
>
  <div class="cart-sheet">
    <header>
      <div>
        <p class="cart-kicker">{c.fab}</p>
        <h2 id="cart-dialog-title">{c.title}</h2>
      </div>
      <button class="cart-close" type="button" data-cart-close>{c.close}</button>
    </header>
    <ul class="cart-lines" data-cart-dialog-lines></ul>
    <div class="cart-total" data-cart-dialog-total></div>
    <button class="cart-clear" type="button" data-cart-clear>{c.clear}</button>
    <p class="cart-hint">{c.checkoutHint}</p>
    <div class="cart-actions">
      <a class="btn" href="#fork" data-open-door="takeaway" data-cart-destination>{c.pickup}</a>
      <a class="btn btn-line" href="#fork" data-open-door="order" data-cart-destination>{c.delivery}</a>
      <a class="btn btn-line" href="#fork" data-open-door="visit" data-cart-destination>{c.visit}</a>
    </div>
  </div>
</dialog>

<style>
  .cart-fab {
    position: fixed;
    z-index: 39;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 14px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    box-shadow: 0 10px 26px -14px rgb(35 30 25 / 0.7);
    transition:
      bottom calc(0.35s * var(--motion)) var(--ease),
      background-color 0.2s var(--ease-out-expo);
  }
  .cart-fab[hidden] {
    display: none;
  }
  .cart-fab:hover {
    background: var(--color-red-ink);
  }
  .cart-fab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .cart-fab :global(.bag) {
    width: 22px;
    height: 22px;
  }
  .count {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    padding-inline: 6px;
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-red-ink);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .sum {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .sum:empty {
    display: none;
  }

  .cart-dialog {
    position: fixed;
    inset: auto max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) auto;
    width: min(calc(100% - 32px), 480px);
    max-width: none;
    max-height: min(720px, calc(100dvh - 32px));
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 28px;
    color: var(--color-ink);
    background: var(--color-cream);
    box-shadow: 0 24px 64px -28px rgb(35 30 25 / 0.72);
    overflow: hidden;
  }
  .cart-dialog::backdrop {
    background: rgb(36 34 29 / 0.48);
  }
  .cart-sheet {
    max-height: min(720px, calc(100dvh - 32px));
    overflow-y: auto;
    padding: 28px;
    overscroll-behavior: contain;
  }
  .cart-sheet header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  .cart-kicker {
    color: var(--color-red-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .cart-sheet h2 {
    margin-top: 3px;
    font: 600 clamp(30px, 5vw, 40px)/1.05 var(--font-display);
  }
  .cart-close {
    flex: none;
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px solid var(--color-coffee);
    border-radius: 999px;
    color: var(--color-ink);
    background: transparent;
    font: 500 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .cart-close:hover {
    color: #fff;
    background: var(--color-coffee);
  }
  .cart-lines {
    display: grid;
    margin-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .cart-lines :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px 18px;
    padding: 15px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .cart-lines :global(.cart-line-name) {
    min-width: 0;
    font-weight: 500;
    line-height: 1.3;
  }
  .cart-lines :global(.cart-line-qty) {
    color: var(--color-muted);
    font-size: 13px;
  }
  .cart-lines :global(.cart-line-price) {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    color: var(--color-red-ink);
    font: 600 16px/1.2 var(--font-sans);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cart-total {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 20px;
    padding-top: 2px;
    font-weight: 600;
  }
  .cart-total :global(strong) {
    padding: 8px 12px;
    border-radius: 999px;
    color: #fff;
    background: var(--color-red);
    font: 700 20px/1 var(--font-sans);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cart-total :global(small) {
    display: block;
    margin-top: 5px;
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 400;
  }
  .cart-clear {
    min-height: 44px;
    margin-top: 8px;
    padding: 0;
    border: 0;
    color: var(--color-red-ink);
    background: transparent;
    font: 500 14px/1 var(--font-sans);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .cart-clear:hover {
    color: var(--color-coffee-deep);
  }
  .cart-hint {
    margin-top: 24px;
    color: var(--color-muted);
    font-size: 14px;
  }
  .cart-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin-top: 12px;
  }
  .cart-actions :global(.btn) {
    justify-content: center;
    width: 100%;
  }

  /* пока идёт заставка, кнопка не мешает */
  :global(body:has([data-hero]:not([data-intro='done']))) .cart-fab {
    opacity: 0;
    pointer-events: none;
  }
  /* кнопка «Твики» (только на dev-сервере) стоит в том же углу — поднимаемся над ней */
  :global(body:has([data-tweaks-open])) .cart-fab {
    bottom: calc(max(16px, env(safe-area-inset-bottom)) + 52px);
  }
  /* на телефоне статус работы слева внизу во всю ширину не влезает рядом — встаём над ним */
  @media (max-width: 720px) {
    .cart-fab {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 56px);
    }
    .label {
      display: none;
    }
    :global(body:has([data-action-bar][data-state='shown'])) .cart-fab {
      bottom: calc(146px + env(safe-area-inset-bottom, 0px));
    }
    .cart-dialog {
      inset: auto 0 0;
      width: 100%;
      max-height: calc(100dvh - 24px);
      border-radius: 28px 28px 0 0;
    }
    .cart-sheet {
      max-height: calc(100dvh - 24px);
      padding: 24px 20px calc(24px + env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-fab {
      transition: none;
    }
  }
</style>

<script>
  import { cartLines, cartTotals, clearCart, onCart } from '../scripts/cart';

  const fab = document.querySelector<HTMLButtonElement>('[data-cart-fab]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cart-dialog]');
  if (fab && dialog) {
    const totalLabel = dialog.dataset.total!;
    const atCounter = dialog.dataset.atCounter!;
    const plusCounter = dialog.dataset.plusCounter!;
    const linesRoot = dialog.querySelector<HTMLElement>('[data-cart-dialog-lines]')!;
    const totalRoot = dialog.querySelector<HTMLElement>('[data-cart-dialog-total]')!;
    const paint = () => {
      const { count, sum, unpriced } = cartTotals();
      fab.hidden = count === 0;
      fab.querySelector('[data-fab-count]')!.textContent = String(count);
      fab.querySelector('[data-fab-sum]')!.textContent = sum ? `${sum} SAR` : '';
      linesRoot.innerHTML = cartLines().map(({ item, qty }) => {
        const price = item.price !== undefined ? `${item.price * qty} SAR` : item.priceText ? `${item.priceText} SAR` : atCounter;
        return `<li><span class="cart-line-name">${item.ru}</span><span class="cart-line-qty">${qty} ×</span><span class="cart-line-price">${price}</span></li>`;
      }).join('');
      totalRoot.innerHTML = `<span>${totalLabel}${unpriced ? `<small>${plusCounter}</small>` : ''}</span><strong>${sum} SAR</strong>`;
      if (!count && dialog.open) dialog.close();
    };
    fab.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-cart-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-cart-clear]')?.addEventListener('click', clearCart);
    dialog.querySelectorAll('[data-cart-destination]').forEach((link) => link.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    onCart(paint);
    paint();
  }
</script>
