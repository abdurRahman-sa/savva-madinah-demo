---
// Панель твиков: только на локальном сервере (npm run dev), в сборку не попадает.
// Каждая ручка меняет переменную из global.css прямо на живой странице.
type Control =
  | { kind: 'range'; label: string; token: string; min: number; max: number; step: number; unit: string; value: number }
  | { kind: 'color'; label: string; token: string; value: string }
  | { kind: 'select'; label: string; token: string; value: string; options: { label: string; value: string }[] };

type Group = { title: string; controls: Control[] };

// Примерка цвета фото развилки: варианты собирает `node scripts/grade-photos.mjs --preview`,
// dev-сервер отдаёт их по адресу /@fs/… — в сборку они не попадают.
const gradesDir = `${process.cwd()}/scripts/photo-grades`;
const grades = [
  { value: '', label: 'Как в коде сейчас' },
  { value: 'original', label: 'Оригинал' },
  { value: 'soft', label: 'Мягкий' },
  { value: 'medium', label: 'Средний' },
  { value: 'strong', label: 'Сильный' },
];

const fonts = [
  { label: 'El Messiri', value: '"El Messiri Variable", serif' },
  { label: 'Rubik', value: '"Rubik Variable", sans-serif' },
  { label: 'Caveat', value: '"Caveat Variable", cursive' },
  { label: 'Georgia', value: 'Georgia, serif' },
  { label: 'Системный', value: 'system-ui, sans-serif' },
];

const groups: Group[] = [
  {
    title: 'Заголовки',
    controls: [
      { kind: 'select', label: 'Шрифт', token: '--font-display', value: '"El Messiri Variable", serif', options: fonts },
      { kind: 'range', label: 'Размер', token: '--display-scale', min: 0.6, max: 1.8, step: 0.02, unit: '', value: 0.8 },
      { kind: 'range', label: 'Начертание', token: '--display-weight', min: 400, max: 700, step: 10, unit: '', value: 400 },
      { kind: 'range', label: 'Межстрочный', token: '--display-leading', min: 0.8, max: 1.8, step: 0.01, unit: '', value: 1.25 },
      { kind: 'range', label: 'Межбуквенный', token: '--display-tracking', min: -0.06, max: 0.08, step: 0.002, unit: 'em', value: -0.01 },
      { kind: 'range', label: 'Логотип, высота', token: '--logo-height', min: 0.4, max: 1.6, step: 0.01, unit: 'em', value: 0.8 },
      { kind: 'range', label: 'COFFEE, разрядка', token: '--coffee-tracking', min: 0.4, max: 2.4, step: 0.05, unit: 'em', value: 1.4 },
    ],
  },
  {
    title: 'Текст',
    controls: [
      { kind: 'select', label: 'Шрифт', token: '--font-sans', value: '"Rubik Variable", sans-serif', options: fonts },
      { kind: 'range', label: 'Размер', token: '--text-size', min: 13, max: 22, step: 0.5, unit: 'px', value: 16 },
      { kind: 'range', label: 'Межстрочный', token: '--text-leading', min: 1.2, max: 2, step: 0.02, unit: '', value: 1.5 },
      { kind: 'select', label: 'Рукописный шрифт', token: '--font-hand', value: '"Caveat Variable", cursive', options: fonts },
      { kind: 'range', label: 'Рукописный, размер', token: '--hand-size', min: 20, max: 56, step: 1, unit: 'px', value: 34 },
      { kind: 'range', label: 'Рукописный, наклон', token: '--hand-tilt', min: -10, max: 10, step: 0.5, unit: 'deg', value: -3 },
    ],
  },
  {
    title: 'Цвета',
    controls: [
      { kind: 'color', label: 'Акцент, красный', token: '--color-red', value: '#ab3a36' },
      { kind: 'color', label: 'Тёмный, синева', token: '--color-shade', value: '#3c3c4a' },
      { kind: 'color', label: 'Шалфей', token: '--color-sage', value: '#5c6450' },
      { kind: 'color', label: 'Кофейный', token: '--color-coffee', value: '#6f4a2e' },
      { kind: 'color', label: 'Фон, песок', token: '--color-linen', value: '#f2ebdc' },
      { kind: 'color', label: 'Фон, сливочный', token: '--color-cream', value: '#f7efe0' },
      { kind: 'color', label: 'Текст', token: '--color-ink', value: '#40463a' },
      { kind: 'color', label: 'Текст приглушённый', token: '--color-muted', value: '#5d634f' },
    ],
  },
  {
    title: 'Раскладка',
    controls: [
      { kind: 'range', label: 'Ширина контента', token: '--wrap-max', min: 900, max: 1800, step: 20, unit: 'px', value: 1280 },
      { kind: 'range', label: 'Поля по бокам', token: '--wrap-gutter', min: 12, max: 64, step: 2, unit: 'px', value: 28 },
      { kind: 'range', label: 'Развилка: высота (воздух внутри)', token: '--fork-pad', min: 16, max: 200, step: 4, unit: 'px', value: 52 },
      { kind: 'range', label: 'Герой → развилка: расстояние', token: '--fork-gap', min: 40, max: 320, step: 4, unit: 'px', value: 140 },
      { kind: 'range', label: 'Меню: воздух над заголовком', token: '--menu-pad-top', min: 8, max: 160, step: 2, unit: 'px', value: 52 },
      { kind: 'range', label: 'Меню: ширина плашки (± с каждой стороны)', token: '--menu-widen', min: -120, max: 200, step: 2, unit: 'px', value: 58 },
      { kind: 'range', label: 'Развилка → меню: зазор', token: '--menu-gap', min: 0, max: 200, step: 2, unit: 'px', value: 36 },
      { kind: 'range', label: 'Остальные блоки: высота (воздух внутри)', token: '--block-pad', min: 16, max: 200, step: 4, unit: 'px', value: 52 },
      { kind: 'range', label: 'Остальные блоки: расстояние между', token: '--block-gap', min: 40, max: 320, step: 4, unit: 'px', value: 140 },
      { kind: 'range', label: 'Скругление блоков', token: '--radius-block', min: 0, max: 60, step: 1, unit: 'px', value: 34 },
      { kind: 'range', label: 'Скругление кусочков', token: '--radius-tile', min: 0, max: 40, step: 1, unit: 'px', value: 14 },
    ],
  },
  {
    title: 'Первый экран',
    controls: [
      {
        kind: 'select',
        label: 'Вступление: шрифт',
        token: '--lead-font',
        value: 'var(--font-hand)',
        options: [
          { label: 'Caveat (рукописный, в коде)', value: 'var(--font-hand)' },
          { label: 'Rubik', value: 'var(--font-sans)' },
          { label: 'El Messiri (акцентный)', value: 'var(--font-display)' },
        ],
      },
      {
        kind: 'select',
        label: 'Вступление: цвет',
        token: '--lead-color',
        value: 'var(--color-ink)',
        options: [
          { label: 'Шалфейный текст (как сейчас)', value: 'var(--color-ink)' },
          { label: 'Красный (акцент)', value: 'var(--color-red)' },
          { label: 'Кофейный', value: 'var(--color-coffee)' },
        ],
      },
      { kind: 'range', label: 'Вступление: начертание', token: '--lead-weight', min: 300, max: 700, step: 50, unit: '', value: 500 },
      { kind: 'range', label: 'Вступление: масштаб', token: '--lead-scale', min: 0.7, max: 1.6, step: 0.02, unit: '', value: 1.2 },
      { kind: 'range', label: 'Колонок', token: '--collage-cols', min: 2, max: 12, step: 1, unit: '', value: 6 },
      { kind: 'range', label: 'Зазор в коллаже', token: '--collage-gap', min: 0, max: 24, step: 1, unit: 'px', value: 9 },
      { kind: 'range', label: 'Рядов', token: '--collage-rows', min: 1, max: 12, step: 1, unit: '', value: 2 },
      { kind: 'range', label: 'Подъём Savva: планшет', token: '--brand-lift-tablet', min: -60, max: 120, step: 1, unit: 'px', value: 0 },
      { kind: 'range', label: 'Подъём Savva: ноутбук', token: '--brand-lift-desktop', min: -60, max: 120, step: 1, unit: 'px', value: 58 },
      { kind: 'range', label: 'Высота кадра: телефон (доля ширины)', token: '--tile-ratio-phone', min: 0.6, max: 1.6, step: 0.05, unit: '', value: 1.2 },
      { kind: 'range', label: 'Высота коллажа (минимум)', token: '--collage-min', min: 30, max: 80, step: 1, unit: 'svh', value: 60 },
    ],
  },
  {
    title: 'Отзывы',
    controls: [
      { kind: 'range', label: 'Воздух блока сверху/снизу', token: '--reviews-pad', min: 24, max: 180, step: 2, unit: 'px', value: 38 },
      { kind: 'range', label: 'Заголовок → карточки', token: '--reviews-title-gap', min: 12, max: 100, step: 2, unit: 'px', value: 34 },
      { kind: 'range', label: 'Между карточками', token: '--reviews-card-gap', min: 4, max: 48, step: 1, unit: 'px', value: 14 },
      { kind: 'range', label: 'Воздух внутри карточек', token: '--reviews-card-pad', min: 16, max: 64, step: 1, unit: 'px', value: 34 },
      { kind: 'range', label: 'Размер заголовка', token: '--reviews-heading-scale', min: 0.7, max: 1.5, step: 0.02, unit: '', value: 1 },
      { kind: 'range', label: 'Размер текста отзывов', token: '--reviews-quote-size', min: 14, max: 28, step: 0.5, unit: 'px', value: 19 },
      { kind: 'range', label: 'Размер оценки 4.7', token: '--reviews-rating-size', min: 64, max: 150, step: 2, unit: 'px', value: 116 },
    ],
  },
  {
    title: 'Футер',
    controls: [
      { kind: 'range', label: 'Воздух между строками', token: '--footer-row-gap', min: 4, max: 36, step: 1, unit: 'px', value: 9 },
    ],
  },
  {
    title: 'Анимация',
    controls: [
      { kind: 'range', label: 'Скорость (1 = как сейчас)', token: '--motion', min: 0, max: 2.5, step: 0.05, unit: '', value: 1 },
      { kind: 'range', label: 'Имя наливается по центру', token: '--brand-reveal', min: 0.3, max: 4, step: 0.05, unit: 's', value: 1.8 },
      { kind: 'range', label: 'Имя стоит по центру', token: '--intro-lead', min: 0, max: 3, step: 0.1, unit: 's', value: 0.8 },
      { kind: 'range', label: 'Имя переезжает на место', token: '--intro-move', min: 0.3, max: 2.5, step: 0.05, unit: 's', value: 1.2 },
      { kind: 'range', label: 'Коллаж и кнопки проявляются за', token: '--collage-reveal', min: 0.2, max: 2, step: 0.05, unit: 's', value: 0.5 },
      {
        kind: 'select',
        label: 'Кривая',
        token: '--ease',
        value: 'cubic-bezier(0.16, 1, 0.3, 1)',
        options: [
          { label: 'Мягкое торможение', value: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          { label: 'Плавная', value: 'ease-in-out' },
          { label: 'Ровная', value: 'linear' },
          { label: 'Энергичное торможение', value: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { label: 'Резкая', value: 'cubic-bezier(0.4, 0, 0.2, 1)' },
        ],
      },
    ],
  },
];
---

<aside class="tweaks" data-tweaks hidden>
  <header>
    <b>Твики</b>
    <div class="head-actions">
      <button type="button" data-copy>Скопировать CSS</button>
      <button type="button" data-reset>Сбросить</button>
      <button type="button" data-close aria-label="Свернуть">×</button>
    </div>
  </header>
  <div class="replay">
    <button type="button" data-replay>Проиграть заставку</button>
    <label class="grade">
      <span>Цвет фото развилки</span>
      <select data-grade data-dir={gradesDir}>
        {grades.map((grade) => <option value={grade.value}>{grade.label}</option>)}
      </select>
    </label>
    <label class="grade">
      <span>Фон развилки</span>
      <select data-fork-bg>
        <option value="">Шалфей (как в коде)</option>
        <option value="none">Песочный, без фона</option>
        <option value="cream">Сливочная полоса</option>
        <option value="shade">Тёплая синева</option>
        <option value="awning">Полоса навеса</option>
      </select>
    </label>
  </div>
  <div class="body">
    {
      groups.map((group) => (
        <details open>
          <summary>{group.title}</summary>
          {group.controls.map((control) => (
            <div class="item">
            <label class="row">
              <span class="name">{control.label}</span>
              {control.kind === 'range' && (
                <span class="field">
                  <input
                    type="range"
                    data-token={control.token}
                    data-unit={control.unit}
                    data-default={control.value}
                    min={control.min}
                    max={control.max}
                    step={control.step}
                    value={control.value}
                  />
                  <output>
                    {control.value}
                    {control.unit}
                  </output>
                </span>
              )}
              {control.kind === 'color' && (
                <span class="field">
                  <input type="color" data-token={control.token} data-unit="" data-default={control.value} value={control.value} />
                  <output>{control.value}</output>
                </span>
              )}
              {control.kind === 'select' && (
                <span class="field">
                  <select data-token={control.token} data-unit="" data-default={control.value}>
                    {control.options.map((option) => (
                      <option value={option.value} selected={option.value === control.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </span>
              )}
            </label>
            <button type="button" class="return" data-return={control.token} disabled>
              Вернуть {control.kind === 'range' ? `${control.value}${control.unit}` : 'как было'}
            </button>
            </div>
          ))}
        </details>
      ))
    }
  </div>
  <footer class="note" data-note>Меняется только эта страница. Кнопка отдаёт CSS с тем, что вы правда трогали.</footer>
</aside>

<button class="tweaks-open" type="button" data-tweaks-open>Твики</button>

<style>
  .tweaks,
  .tweaks-open {
    position: fixed;
    z-index: 9999;
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: #f4f1ea;
  }
  .tweaks-open {
    right: 16px;
    bottom: 16px;
    border: 0;
    border-radius: 999px;
    background: #1d1d22;
    padding: 10px 18px;
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.8);
  }
  .tweaks {
    top: 16px;
    right: 16px;
    width: 330px;
    max-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    background: #1d1d22;
    border-radius: 16px;
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.9);
    font-size: 12.5px;
  }
  .tweaks[hidden] {
    display: none;
  }
  .tweaks header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 12px 10px;
    border-bottom: 1px solid #33333c;
  }
  .head-actions {
    display: flex;
    gap: 6px;
  }
  .tweaks button {
    font: inherit;
    color: #f4f1ea;
    background: #2b2b33;
    border: 0;
    border-radius: 8px;
    padding: 6px 10px;
    cursor: pointer;
  }
  .tweaks button:hover {
    background: #3a3a45;
  }
  .tweaks .replay {
    padding: 10px 12px 0;
  }
  .tweaks .replay button {
    width: 100%;
    padding: 9px 10px;
    color: #1d1d22;
    background: #f0a93a;
    font-weight: 600;
  }
  .tweaks .replay button:hover {
    background: #f4bd62;
  }
  .tweaks .grade {
    display: grid;
    gap: 6px;
    margin-top: 10px;
    color: #c9c6be;
  }
  .tweaks .grade select {
    font: inherit;
    color: #f4f1ea;
    background: #2b2b33;
    border: 0;
    border-radius: 8px;
    padding: 7px 8px;
  }
  .tweaks .body {
    overflow-y: auto;
    padding: 6px 12px 12px;
  }
  .tweaks details {
    border-bottom: 1px solid #2b2b33;
    padding: 6px 0;
  }
  .tweaks summary {
    cursor: pointer;
    padding: 6px 0;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 140px;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
  }
  .name {
    color: #c9c6be;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .field input[type='range'] {
    width: 88px;
    accent-color: #e0705f;
  }
  .field input[type='color'] {
    width: 34px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
  }
  .field select {
    width: 100%;
    font: inherit;
    color: #f4f1ea;
    background: #2b2b33;
    border: 0;
    border-radius: 8px;
    padding: 5px 6px;
  }
  .field output {
    min-width: 46px;
    font-variant-numeric: tabular-nums;
    color: #8f8c85;
  }
  .row.changed .name {
    color: #f0a93a;
  }
  /* «Вернуть» под каждой ручкой: активна, только когда значение сдвинуто */
  .tweaks .return {
    display: block;
    margin: 0 0 6px auto;
    padding: 3px 8px;
    font-size: 11.5px;
    color: #f0a93a;
    background: transparent;
    box-shadow: inset 0 0 0 1px #4a4038;
  }
  .tweaks .return:hover {
    background: #2b2b33;
  }
  .tweaks .return:disabled {
    color: #5b5953;
    box-shadow: inset 0 0 0 1px #2b2b33;
    cursor: default;
  }
  .tweaks .return:disabled:hover {
    background: transparent;
  }
  .note {
    padding: 10px 12px;
    border-top: 1px solid #33333c;
    color: #8f8c85;
    line-height: 1.35;
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-tweaks]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-tweaks-open]');
  const note = document.querySelector<HTMLElement>('[data-note]');
  const inputs = [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-token]')];
  const STORAGE = 'savva-tweaks';
  const changed = new Map<string, string>();

  function valueOf(input: HTMLInputElement | HTMLSelectElement) {
    return input.value + (input.dataset.unit ?? '');
  }

  function apply(input: HTMLInputElement | HTMLSelectElement, remember = true) {
    const token = input.dataset.token!;
    const value = valueOf(input);
    const isDefault = input.value === input.dataset.default;
    document.documentElement.style.setProperty(token, value);
    if (isDefault) {
      changed.delete(token);
      document.documentElement.style.removeProperty(token);
    } else if (remember) {
      changed.set(token, value);
    }
    input.closest('.row')?.classList.toggle('changed', !isDefault);
    returnFor(input)?.toggleAttribute('disabled', isDefault);
    const out = input.parentElement?.querySelector('output');
    if (out) out.textContent = input.type === 'color' ? input.value : value;
    if (remember) save();
  }

  function returnFor(input: HTMLInputElement | HTMLSelectElement) {
    return input.closest('.item')?.querySelector<HTMLButtonElement>('[data-return]');
  }

  function save() {
    try {
      localStorage.setItem(STORAGE, JSON.stringify([...changed]));
    } catch {
      /* приватный режим */
    }
  }

  function restore() {
    let saved: [string, string][] = [];
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE) ?? '[]');
    } catch {
      /* пусто */
    }
    const map = new Map(saved);
    inputs.forEach((input) => {
      const token = input.dataset.token!;
      if (!map.has(token)) return;
      const unit = input.dataset.unit ?? '';
      const raw = map.get(token)!;
      input.value = unit ? raw.slice(0, -unit.length) : raw;
      apply(input, true);
    });
  }

  inputs.forEach((input) => {
    input.addEventListener('input', () => apply(input));
    // «Вернуть» ставит ручку на значение сайта
    returnFor(input)?.addEventListener('click', () => {
      input.value = input.dataset.default!;
      apply(input);
    });
  });

  document.querySelector('[data-copy]')?.addEventListener('click', async () => {
    if (!changed.size) {
      if (note) note.textContent = 'Пока ничего не менялось, копировать нечего.';
      return;
    }
    const css = [':root {', ...[...changed].map(([token, value]) => `  ${token}: ${value};`), '}'].join('\n');
    try {
      await navigator.clipboard.writeText(css);
      if (note) note.textContent = `Скопировано, ${changed.size} значений:\n${css}`;
    } catch {
      if (note) note.textContent = css;
    }
  });

  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    inputs.forEach((input) => {
      input.value = input.dataset.default!;
      document.documentElement.style.removeProperty(input.dataset.token!);
      input.closest('.row')?.classList.remove('changed');
      returnFor(input)?.setAttribute('disabled', '');
      const out = input.parentElement?.querySelector('output');
      if (out) out.textContent = input.type === 'color' ? input.value : valueOf(input);
    });
    changed.clear();
    save();
    if (note) note.textContent = 'Всё сброшено к значениям сайта.';
  });

  // Заставка идёт раз за визит: забываем, что её видели, и начинаем страницу сначала
  document.querySelector('[data-replay]')?.addEventListener('click', () => {
    try {
      sessionStorage.removeItem('savva-intro-seen');
    } catch {
      /* хранилище недоступно: заставка и так покажется */
    }
    history.scrollRestoration = 'manual';
    scrollTo(0, 0);
    location.reload();
  });

  // Цвет фото: подменяем картинки развилки на варианты из scripts/photo-grades
  const gradeSelect = document.querySelector<HTMLSelectElement>('[data-grade]');
  const GRADE_KEY = `${STORAGE}-grade`;
  const GRADED = /(takeaway-[12]|order-[1-4]|hall-[12]|terrace-[12])\.jpg/;

  function applyGrade(folder: string) {
    document.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
      if (!img.dataset.gradeFile) {
        const match = decodeURIComponent(img.currentSrc || img.src).match(GRADED);
        if (!match) return;
        img.dataset.gradeFile = match[1];
        img.dataset.gradeSrc = img.getAttribute('src') ?? '';
        img.dataset.gradeSrcset = img.getAttribute('srcset') ?? '';
      }
      if (!folder) {
        img.src = img.dataset.gradeSrc!;
        if (img.dataset.gradeSrcset) img.srcset = img.dataset.gradeSrcset;
        return;
      }
      img.removeAttribute('srcset');
      img.src = `/@fs${gradeSelect!.dataset.dir}/${folder}/${img.dataset.gradeFile}.jpg?grade=${folder}`;
    });
  }

  gradeSelect?.addEventListener('change', () => {
    applyGrade(gradeSelect.value);
    try {
      localStorage.setItem(GRADE_KEY, gradeSelect.value);
    } catch {
      /* приватный режим */
    }
    if (note) {
      const label = gradeSelect.selectedOptions[0].textContent;
      note.textContent = gradeSelect.value
        ? `Фото развилки: ${label}. Это только примерка, скажите в чате, какой оставить.`
        : 'Фото развилки как в коде.';
    }
  });

  try {
    const savedGrade = localStorage.getItem(GRADE_KEY) ?? '';
    if (gradeSelect && savedGrade) {
      gradeSelect.value = savedGrade;
      applyGrade(savedGrade);
    }
  } catch {
    /* приватный режим */
  }

  // Фон развилки: ставим data-bg на секцию, стили вариантов — в Fork.astro
  const forkBg = document.querySelector<HTMLSelectElement>('[data-fork-bg]');
  const FORK_BG_KEY = `${STORAGE}-fork-bg`;
  const applyForkBg = (value: string) => {
    const fork = document.getElementById('fork');
    if (!fork) return;
    fork.dataset.bg = value || fork.dataset.bgDefault || '';
  };
  forkBg?.addEventListener('change', () => {
    applyForkBg(forkBg.value);
    try {
      localStorage.setItem(FORK_BG_KEY, forkBg.value);
    } catch {
      /* приватный режим */
    }
    if (note) {
      note.textContent = forkBg.value
        ? `Фон развилки: ${forkBg.selectedOptions[0].textContent}. Это примерка, скажите в чате, какой оставить.`
        : 'Фон развилки как в коде.';
    }
  });
  try {
    const savedBg = localStorage.getItem(FORK_BG_KEY) ?? '';
    if (forkBg && savedBg) {
      forkBg.value = savedBg;
      applyForkBg(savedBg);
    }
  } catch {
    /* приватный режим */
  }

  function togglePanel(open: boolean) {
    if (panel) panel.hidden = !open;
    if (openButton) openButton.hidden = open;
    try {
      localStorage.setItem(`${STORAGE}-open`, open ? '1' : '0');
    } catch {
      /* приватный режим */
    }
  }

  openButton?.addEventListener('click', () => togglePanel(true));
  document.querySelector('[data-close]')?.addEventListener('click', () => togglePanel(false));
  // Панель прячется и показывается по клавише T
  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() === 't' && !/input|select|textarea/i.test((event.target as HTMLElement).tagName)) {
      togglePanel(panel?.hidden ?? true);
    }
  });

  restore();
  let wasOpen = '1';
  try {
    wasOpen = localStorage.getItem(`${STORAGE}-open`) ?? '1';
  } catch {
    /* приватный режим */
  }
  togglePanel(wasOpen === '1');
</script>
