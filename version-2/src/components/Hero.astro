---
import { getImage } from 'astro:assets';
import sharp from 'sharp';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/ru';

// Все настоящие кадры Savva: Instagram, Google Maps и фото кафе, лиц в кадре нет.
const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true }),
).map(([path, m]) => ({ name: path.split('/').pop()!.replace('.jpg', ''), src: m.default }));
const byName = (name: string) => photos.find((p) => p.name === name)!.src;

// Двенадцать кадров в коллаже, остальные ждут в запасе и сменяют их по одному.
const shown = [
  'melon-drink',
  'raspberry-umbrella',
  'hibiscus-pour',
  'cheesecake-window',
  'redvelvet-terrace',
  'tray-tart',
  'cookies-stack',
  'drive-through-tray',
  'matcha-pour',
  'cold-drinks-trio',
  'madini-cookies',
  'facade-day',
];
// Два размера: мелкий для телефона, крупный для монитора
const optimize = async (src: ImageMetadata) => ({
  small: (await getImage({ src, width: 260, format: 'webp' })).src,
  large: (await getImage({ src, width: 480, format: 'webp' })).src,
});
const tiles = await Promise.all(
  shown.map((name) => optimize(byName(name))),
);
// Запас для обновления: остальные кадры подгружаются по мере смены.
// Одно и то же фото бывает в папке дважды (копия в цвете развилки под другим именем),
// поэтому сравниваем сами картинки по отпечатку 16 × 16: из похожих остаётся одно.
// Сначала — кадры стартовой сетки, потом всё остальное по алфавиту.
const fingerprint = async (name: string) =>
  sharp(`${process.cwd()}/src/assets/photos/${name}.jpg`).resize(16, 16, { fit: 'cover' }).greyscale().raw().toBuffer();
const distance = (a: Buffer, b: Buffer) => a.reduce((sum, v, i) => sum + Math.abs(v - b[i]), 0) / a.length;
const ordered = [...shown, ...photos.map((p) => p.name).filter((n) => !shown.includes(n)).sort()];
const unique: { name: string; print: Buffer }[] = [];
for (const name of ordered) {
  const print = await fingerprint(name);
  if (!unique.some((u) => distance(u.print, print) < 15)) unique.push({ name, print });
}
const pool = await Promise.all(unique.map((u) => optimize(byName(u.name))));

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const h = t.hero;
---

<section class="hero" data-hero>
  <!-- имя, строка и действия стоят над коллажем, на чистом фоне -->
  <div class="wrap band">
    <div class="brand-row">
      <svg class="cup" viewBox="16 30 168 222" role="img" aria-label={h.cupAlt}>
        <defs>
          <clipPath id="cup-inside">
            <path d="M32 54 L168 54 L152 236 a14 14 0 0 1 -14 12 L62 248 a14 14 0 0 1 -14 -12 Z" />
          </clipPath>
        </defs>
        <g clip-path="url(#cup-inside)">
          <rect class="liquid" x="28" y="54" width="144" height="196" />
        </g>
        <path
          class="cup-body"
          d="M32 54 L168 54 L152 236 a14 14 0 0 1 -14 12 L62 248 a14 14 0 0 1 -14 -12 Z"
          fill="none"
        />
        <rect class="cup-lid" x="20" y="34" width="160" height="22" rx="8" />
      </svg>
      <h1 class="brand">Savva<i lang="ar" dir="rtl">سافا</i></h1>
    </div>
    <script is:inline>
      // Где имя стоит в заставке: центр экрана, чуть крупнее, но не шире 86% экрана
      (() => {
        const row = document.currentScript.previousElementSibling;
        // Заставка уже была в этом визите: сразу финал, без мигания имени в центре
        try {
          if (sessionStorage.getItem('savva-intro-seen') === '1') row.closest('[data-hero]').dataset.intro = 'done';
        } catch {}
        const place = () => {
          const style = getComputedStyle(row);
          const was = row.style.animation;
          row.style.animation = 'none';
          const r = row.getBoundingClientRect();
          row.style.animation = was;
          const scale = Math.min(1.3, (innerWidth * 0.86) / r.width);
          row.style.setProperty('--fx', `${innerWidth / 2 - (r.left + r.width / 2)}px`);
          row.style.setProperty('--fy', `${innerHeight / 2 - (r.top + r.height / 2)}px`);
          row.style.setProperty('--fs', scale.toFixed(3));
        };
        place();
        // шрифт догружается и меняет ширину имени: пересчитываем
        document.fonts?.ready.then(place);
      })();
    </script>

    <div class="copy">
      <p class="lead">{h.lead}</p>
      <p class="lead-sub">{h.signature}</p>

      <div class="actions">
        <a class="btn" href="#fork" data-open-door="visit">{h.book}</a>
        <a class="btn btn-dark" href="#fork" data-open-door="order">{h.order}</a>
        <a class="btn btn-line" href="#fork" data-open-door="takeaway">{h.route}</a>
        <a class="btn btn-line" href={cafe.phoneHref}>{h.call}</a>
      </div>

      <div class="meta">
        <span class="pill"><b>6:30 – 02:00</b> {h.hours}</span>
        <span class="pill"><b>{cafe.rating}</b> {h.rating}</span>
        <span class="pill">{h.area}</span>
      </div>
    </div>
  </div>

  <div class="collage" role="img" aria-label={h.collageAlt} data-pool={JSON.stringify(pool)}>
    {
      tiles.map((tile, i) => (
        <span class="tile" style={`--step:${i}`}>
          <img
            src={tile.large}
            srcset={`${tile.small} 260w, ${tile.large} 480w`}
            sizes="(max-width: 640px) 34vw, (max-width: 1023px) 26vw, 17vw"
            data-url={tile.large}
            alt=""
            loading="eager"
            decoding="async"
          />
        </span>
      ))
    }
  </div>
  <script is:inline>
    // Порядок кадров меняется при каждой загрузке
    (() => {
      const collage = document.currentScript.previousElementSibling;
      const tiles = [...collage.children];
      for (let i = tiles.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
      }
      tiles.forEach((tile, i) => {
        tile.style.setProperty('--step', i);
        collage.appendChild(tile);
      });
    })();
  </script>

  <button class="skip" type="button" data-skip-intro>{h.skip}</button>
</section>

<style>
  /* Первый экран: сверху полоса с именем и действиями, под ней коллаж до низа экрана */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(var(--collage-min), 1fr);
    overflow: hidden;
    isolation: isolate;
  }

  .band {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: max(clamp(28px, 5vh, 56px), env(safe-area-inset-top));
    padding-bottom: clamp(20px, 3.5vh, 36px);
  }
  /* стакан стоит на базовой линии имени, крышка вровень с верхом «S» */
  .brand-row {
    display: flex;
    align-items: baseline;
    gap: 0.12em;
    font-size: calc(clamp(60px, 11vw, 150px) * var(--display-scale));
  }
  .copy {
    display: grid;
    justify-items: center;
  }
  /* подъём имени ручкой из панели твиков: отдельно для планшета и ноутбука */
  @media (min-width: 641px) and (max-width: 1023px) {
    .brand-row {
      translate: 0 calc(-1 * var(--brand-lift-tablet));
    }
  }
  @media (min-width: 1024px) {
    .brand-row {
      translate: 0 calc(-1 * var(--brand-lift-desktop));
    }
  }

  /* стакан у имени: сначала наливается он, потом имя */
  .cup {
    flex: none;
    /* высота заглавной у El Messiri — 0,68 размера шрифта; viewBox обрезан по краям стакана */
    height: 0.68em;
    width: auto;
  }
  .cup-body,
  .cup-lid {
    fill: none;
    stroke: var(--color-coffee-deep);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .liquid {
    fill: var(--color-melon);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1em;
    line-height: var(--brand-leading);
    letter-spacing: var(--brand-tracking);
    color: var(--color-ink);
    white-space: nowrap;
    /* маска режет всё, что выходит за блок, а при межстрочном 0,84 верх S выходит:
       запас внутри блока, снаружи он же вычитается — место не меняется */
    padding-block: 0.16em 0.08em;
    margin-block: -0.16em -0.08em;
    --brand-fill: 118%;
    -webkit-mask-image: linear-gradient(to top, #000 var(--brand-fill), transparent calc(var(--brand-fill) + 14%));
    mask-image: linear-gradient(to top, #000 var(--brand-fill), transparent calc(var(--brand-fill) + 14%));
  }
  .brand i {
    font-style: normal;
    font-size: 0.26em;
    color: var(--color-sage);
    margin-inline-start: 0.4em;
  }

  /* вступление о кафе: две строки одним шрифтом и одного размера.
     Шрифт, начертание, масштаб и цвет — ручки --lead-font, --lead-weight, --lead-scale, --lead-color (панель твиков) */
  .lead,
  .lead-sub {
    max-width: 30em;
    font-family: var(--lead-font);
    font-size: calc(clamp(17px, 1.6vw, 22px) * var(--lead-scale));
    font-weight: var(--lead-weight);
    /* высота строки не растёт с масштабом: буквы крупнее, место под текст то же —
       полоса над коллажем не меняется, первый ряд кадров стоит на месте */
    line-height: calc(1.3 / var(--lead-scale));
    color: var(--lead-color);
    text-wrap: balance;
  }
  .lead {
    margin-top: clamp(14px, 2.4vh, 24px);
  }
  .lead-sub {
    margin-top: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(14px, 2.2vh, 22px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: clamp(12px, 1.8vh, 18px);
  }

  /* коллаж: 12 кадров ровной сеткой, все видны целиком */
  .collage {
    display: grid;
    grid-template-columns: repeat(var(--collage-cols), minmax(0, 1fr));
    grid-template-rows: repeat(var(--collage-rows), minmax(0, 1fr));
    gap: var(--collage-gap);
    padding: 0 var(--collage-gap) var(--collage-gap);
    min-height: 0;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-tile);
    background: var(--color-cream);
  }
  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity calc(0.5s * var(--motion)) var(--ease);
  }

  .skip {
    position: absolute;
    right: 20px;
    bottom: 20px;
    font: 500 14px/1 var(--font-sans);
    color: var(--color-ink);
    background: var(--color-cream);
    border: 0;
    border-radius: 999px;
    padding: 12px 18px;
    cursor: pointer;
  }
  .skip:hover {
    color: var(--color-red);
  }

  /* Монитор: имя слева, строка и действия справа — полоса ниже, коллажу больше места */
  @media (min-width: 1024px) {
    .band {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(28px, 3.5vw, 56px);
      justify-items: start;
      text-align: start;
    }
    .brand-row {
      font-size: calc(clamp(96px, 9vw, 136px) * var(--display-scale));
    }
    .copy {
      justify-items: start;
      padding-bottom: 0.3em;
    }
    .lead {
      margin-top: 0;
    }
    .actions,
    .meta {
      justify-content: flex-start;
    }
    .actions {
      gap: 8px;
    }
    .actions .btn {
      padding-inline: 22px;
    }
    .actions .btn-line {
      padding-inline: 18px;
    }
  }

  /* Телефон: кадр выше, чем позволяет экран, — коллаж просто уходит ниже первого экрана.
     Высота кадра задаётся долей от ширины: --tile-ratio-phone (1 — квадрат, 1,33 — как фото в Instagram) */
  @media (max-width: 640px) {
    .hero {
      grid-template-rows: auto auto;
    }
    .collage {
      grid-template-rows: none;
      grid-auto-rows: auto;
    }
    .tile {
      aspect-ratio: 1 / var(--tile-ratio-phone);
    }
  }

  /* Телефон: кнопки двумя рядами по две, одной ширины */
  @media (max-width: 640px) {
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      max-width: 420px;
    }
    .actions .btn {
      justify-content: center;
      padding-inline: 12px;
      font-size: 15px;
    }
    .meta .pill {
      padding: 8px 12px;
      font-size: 13px;
    }
    .skip {
      right: 50%;
      transform: translateX(50%);
    }
  }

  /* Заставка в три такта:
     1) имя со стаканом по центру экрана наливается (--brand-reveal);
     2) стоит по центру (--intro-lead) и переезжает на своё место (--intro-move);
     3) когда имя встало, за --collage-reveal проявляются кадры, за ними строка, кнопки, плашки.
     Смещение к центру (--fx, --fy, --fs) считает скрипт сразу после разметки. */
  .hero {
    --t-reveal: calc(var(--brand-reveal) * var(--motion));
    --t-move: calc(var(--intro-move) * var(--motion));
    --t-home: calc(var(--t-reveal) + var(--intro-lead) * var(--motion));
    --t-rest: calc(var(--t-home) + var(--t-move));
    --t-window: calc(var(--collage-reveal) * var(--motion));
  }
  .brand-row,
  .tile,
  .liquid,
  .brand,
  .lead,
  .lead-sub,
  .actions,
  .meta {
    animation-duration: calc(0.45s * var(--motion));
    animation-timing-function: var(--ease);
    animation-fill-mode: both;
  }
  .brand-row {
    animation-name: brand-home;
    animation-duration: var(--t-move);
    animation-delay: var(--t-home);
    animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }
  .liquid {
    animation-name: pour;
    animation-duration: calc(var(--t-reveal) * 0.85);
  }
  .brand {
    animation-name: brand-pour;
    animation-duration: var(--t-reveal);
    animation-delay: calc(0.2s * var(--motion));
  }
  /* кадры по очереди в первой половине окна, текст и кнопки — во второй */
  .tile {
    animation-name: tile-in;
    animation-duration: calc(var(--t-window) * 0.5);
    animation-delay: calc(var(--t-rest) + var(--step) * var(--t-window) * 0.5 / 11);
  }
  .lead,
  .lead-sub,
  .actions,
  .meta {
    animation-name: rise;
    animation-duration: calc(var(--t-window) * 0.5);
    animation-delay: calc(var(--t-rest) + var(--t-window) * 0.4);
  }
  .actions {
    animation-delay: calc(var(--t-rest) + var(--t-window) * 0.45);
  }
  .meta {
    animation-delay: calc(var(--t-rest) + var(--t-window) * 0.5);
  }
  .skip {
    animation: rise 0.3s var(--ease-out-expo) 0.4s both;
  }
  .hero[data-intro='done'] .skip {
    display: none;
  }
  .hero[data-intro='done'] .brand-row,
  .hero[data-intro='done'] .tile,
  .hero[data-intro='done'] .liquid,
  .hero[data-intro='done'] .brand,
  .hero[data-intro='done'] .lead,
  .hero[data-intro='done'] .lead-sub,
  .hero[data-intro='done'] .actions,
  .hero[data-intro='done'] .meta {
    animation: none;
  }

  /* из центра экрана на своё место */
  @keyframes brand-home {
    from {
      transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(var(--fs, 1));
    }
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  @keyframes pour {
    from {
      transform: scaleY(0);
    }
  }
  /* имя наливается снизу вверх: то же движение, что у стакана */
  @keyframes brand-pour {
    from {
      --brand-fill: 0%;
      opacity: 0.35;
    }
    60% {
      opacity: 1;
    }
    to {
      --brand-fill: 118%;
      opacity: 1;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-row,
    .tile,
    .liquid,
    .brand,
    .lead,
    .lead-sub,
    .actions,
    .meta {
      animation: none;
    }
    .skip {
      display: none;
    }
  }
</style>

<script>
  // Кусочки коллажа по одному сменяют фото: за минуту гость видит весь запас кадров
  const collage = document.querySelector<HTMLElement>('[data-pool]');
  const pool: { small: string; large: string }[] = JSON.parse(collage?.dataset.pool ?? '[]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  function swapOneTile() {
    if (!collage) return;
    const images = [...collage.querySelectorAll<HTMLImageElement>('img')];
    const used = new Set(images.map((img) => img.dataset.url));
    const fresh = pool.filter((photo) => !used.has(photo.large));
    if (!fresh.length) return;

    const image = images[Math.floor(Math.random() * images.length)];
    const next = fresh[Math.floor(Math.random() * fresh.length)];
    const preload = new Image();
    preload.srcset = `${next.small} 260w, ${next.large} 480w`;
    preload.sizes = image.sizes;
    preload.src = next.large;
    preload
      .decode()
      .catch(() => {})
      .then(() => {
        image.style.opacity = '0';
        setTimeout(() => {
          image.srcset = preload.srcset;
          image.src = next.large;
          image.dataset.url = next.large;
          image.style.opacity = '';
        }, 500);
      });
  }

  let onScreen = true;
  function tick() {
    // Смена идёт, только пока первый экран виден и движение не выключено
    if (onScreen && !document.hidden && !calm.matches) swapOneTile();
    setTimeout(tick, 2800 + Math.random() * 1700);
  }

  if (collage && pool.length > collage.children.length) {
    // Смены начинаются после заставки
    setTimeout(tick, 6000);
    new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), { threshold: 0.15 }).observe(collage);
  }

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const KEY = 'savva-intro-seen';

  function finishIntro() {
    if (!hero || hero.dataset.intro === 'done') return;
    hero.dataset.intro = 'done';
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {
      /* приватный режим: заставка просто повторится */
    }
  }

  // Длина заставки из тех же переменных, что и в CSS (панель твиков их меняет)
  function introLength() {
    const css = getComputedStyle(hero ?? document.documentElement);
    const sec = (name: string) => parseFloat(css.getPropertyValue(name)) || 0;
    const motion = sec('--motion') || 1;
    return (sec('--brand-reveal') + sec('--intro-lead') + sec('--intro-move') + sec('--collage-reveal')) * motion * 1000;
  }

  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
  } catch {
    /* хранилище недоступно */
  }

  if (seen) {
    // За визит заставка показывается один раз
    if (hero) hero.dataset.intro = 'done';
  } else {
    // Помечаем как просмотренную, когда сцена доиграла
    setTimeout(finishIntro, introLength() + 300);
    document.querySelector('[data-skip-intro]')?.addEventListener('click', finishIntro);
    window.addEventListener('pointerdown', finishIntro, { once: true });
    window.addEventListener('keydown', finishIntro, { once: true });
    window.addEventListener('wheel', finishIntro, { once: true, passive: true });
  }
</script>
