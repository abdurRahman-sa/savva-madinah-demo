---
import { Image } from 'astro:assets';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import hibiscusCup from '../assets/photos/hibiscus-cup.jpg';
import hibiscusPour from '../assets/photos/hibiscus-pour.jpg';
import matchaMelon from '../assets/photos/matcha-berry-vs-melon.jpg';
import cookies from '../assets/photos/madini-cookies.jpg';
import sandwich from '../assets/photos/sandwich-plate.jpg';
import coffeePour from '../assets/photos/coffee-pour-cups.jpg';
import coldTrio from '../assets/photos/cold-drinks-trio.jpg';
import drinksShelf from '../assets/photos/cold-drinks-shelf.jpg';
import driveThrough from '../assets/photos/drive-through-tray.jpg';
import breakfastLaptop from '../assets/photos/breakfast-laptop.jpg';
import terrace from '../assets/photos/terrace-day.jpg';
import juice from '../assets/photos/juice.jpg';
import cappuccino from '../assets/photos/cappuccino.jpg';
import cakeCup from '../assets/photos/cake-cup.jpg';
import cheesecakeWindow from '../assets/photos/cheesecake-window.jpg';
import interiorLounge from '../assets/photos/interior-lounge.jpg';
import cookiesPlate from '../assets/photos/cookies-plate.jpg';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const h = t.hero;

// Коллаж: 17 настоящих кадров Savva, без повторов. Крупные и широкий кусочки
// ломают сетку, порядок появления перемешивается при каждой загрузке.
const tiles = [
  { src: hibiscusPour },
  { src: cookiesPlate },
  { src: coldTrio },
  { src: interiorLounge, size: 'big' },
  { src: sandwich },
  { src: matchaMelon },
  { src: coffeePour },
  { src: cheesecakeWindow, size: 'wide' },
  { src: drinksShelf },
  { src: breakfastLaptop },
  { src: cakeCup, size: 'big' },
  { src: driveThrough },
  { src: juice },
  { src: terrace },
  { src: hibiscusCup },
  { src: cappuccino },
  { src: cookies },
];
---

<section class="hero" data-hero>
  <div class="collage" role="img" aria-label={h.collageAlt}>
    {
      tiles.map((tile, i) => (
        <span class:list={['tile', tile.size]} style={`--step:${i}`}>
          <Image src={tile.src} alt="" widths={[220, 420]} sizes="(max-width: 720px) 30vw, 20vw" loading="eager" />
        </span>
      ))
    }
  </div>
  <script is:inline>
    // Порядок кусочков меняется при каждой загрузке
    (() => {
      const collage = document.currentScript.previousElementSibling;
      const tiles = [...collage.children];
      for (let i = tiles.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
      }
      tiles.forEach((tile, i) => {
        tile.style.setProperty('--step', i);
        collage.appendChild(tile);
      });
    })();
  </script>
  <div class="veil" aria-hidden="true"></div>
  <div class="ribbon" aria-hidden="true"></div>

  <div class="wrap stage">
    <div class="cup-wrap">
      <svg class="cup" viewBox="0 0 200 268" role="img" aria-label={h.cupAlt}>
        <defs>
          <clipPath id="cup-inside">
            <path d="M32 54 L168 54 L152 236 a14 14 0 0 1 -14 12 L62 248 a14 14 0 0 1 -14 -12 Z" />
          </clipPath>
        </defs>
        <g clip-path="url(#cup-inside)">
          <rect class="liquid" x="28" y="54" width="144" height="196" />
        </g>
        <path
          class="cup-body"
          d="M32 54 L168 54 L152 236 a14 14 0 0 1 -14 12 L62 248 a14 14 0 0 1 -14 -12 Z"
          fill="none"
        />
        <rect class="cup-lid" x="20" y="34" width="160" height="22" rx="8" />
        <path class="cup-shine" d="M54 70 L48 226" fill="none" />
      </svg>
      <h1 class="brand">Savva<i lang="ar" dir="rtl">سافا</i></h1>
    </div>

    <p class="lead">{h.lead}</p>

    <div class="actions">
      <a class="btn" href="#fork" data-open-door="visit">{h.book}</a>
      <a class="btn btn-dark" href="#fork" data-open-door="order">{h.order}</a>
      <a class="btn btn-line" href="#fork" data-open-door="takeaway">{h.route}</a>
      <a class="btn btn-line" href={cafe.phoneHref}>{h.call}</a>
    </div>

    <div class="meta">
      <span class="pill"><b>6:30 – 02:00</b> {h.hours}</span>
      <span class="pill"><b>{cafe.rating}</b> {h.rating}</span>
      <span class="pill">{h.area}</span>
    </div>
  </div>

  <button class="skip" type="button" data-skip-intro>{h.skip}</button>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding: clamp(80px, 12vh, 140px) 0 clamp(48px, 8vh, 96px);
    overflow: hidden;
    isolation: isolate;
  }

  /* коллаж из кадров кафе */
  .collage {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    grid-auto-flow: dense;
    gap: 6px;
    padding: 6px;
  }
  .tile {
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-cream);
  }
  .tile.big {
    grid-column: span 2;
    grid-row: span 2;
    border-radius: 22px;
  }
  .tile.wide {
    grid-column: span 2;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(95% 75% at 50% 46%, rgb(233 223 203 / 0.92) 26%, rgb(233 223 203 / 0.74) 58%, rgb(233 223 203 / 0.46) 100%);
  }
  .ribbon {
    position: absolute;
    top: -34px;
    left: -6%;
    width: 112%;
    height: 96px;
    transform: rotate(-4deg);
    background: repeating-linear-gradient(
      90deg,
      var(--color-red) 0 74px,
      var(--color-cream) 74px 126px,
      var(--color-coffee) 126px 168px,
      var(--color-cream) 168px 220px
    );
    box-shadow: 0 18px 40px -22px rgb(60 60 74 / 0.6);
  }

  /* сцена по центру */
  .stage {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0;
  }
  .cup-wrap {
    position: relative;
    display: grid;
    place-items: center;
  }
  .cup {
    width: clamp(170px, 24vh, 270px);
    height: auto;
  }
  .cup-body,
  .cup-shine {
    stroke: var(--color-coffee-deep);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .cup-shine {
    stroke: #fff;
    stroke-width: 6;
    opacity: 0.5;
  }
  .cup-lid {
    fill: none;
    stroke: var(--color-coffee-deep);
    stroke-width: 3;
    opacity: 0.55;
  }
  .liquid {
    fill: var(--color-melon);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  /* надпись поверх стакана, как в референсе, но без тени */
  .brand {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(72px, 15vw, 190px);
    line-height: 0.84;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .brand i {
    font-style: normal;
    font-size: 0.26em;
    color: var(--color-sage);
    margin-left: 16px;
  }

  .lead {
    margin-top: clamp(18px, 4vh, 34px);
    max-width: 24ch;
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 500;
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(18px, 3vh, 26px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(16px, 2.5vh, 24px);
  }
  .skip {
    position: absolute;
    right: 20px;
    bottom: 20px;
    font: 500 14px/1 var(--font-sans);
    color: var(--color-muted);
    background: var(--color-cream);
    border: 0;
    border-radius: 999px;
    padding: 10px 16px;
    cursor: pointer;
  }
  .skip:hover {
    color: var(--color-red);
  }

  /* заставка: 2,5 секунды, коллаж собирается, стакан наполняется, потом надпись и кнопки */
  .tile,
  .liquid,
  .brand,
  .lead,
  .actions,
  .meta {
    animation-duration: 0.4s;
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
  }
  .tile {
    animation-name: tile-in;
    animation-duration: 0.5s;
    animation-delay: calc(var(--step) * 0.06s);
  }
  .liquid {
    animation-name: pour;
    animation-duration: 1.5s;
    animation-delay: 0.15s;
  }
  .brand {
    animation-name: brand-in;
    animation-duration: 0.45s;
    animation-delay: 1.6s;
  }
  .lead {
    animation-name: rise;
    animation-delay: 1.9s;
  }
  .actions {
    animation-name: rise;
    animation-delay: 2.05s;
  }
  .meta {
    animation-name: rise;
    animation-delay: 2.2s;
  }
  .skip {
    animation: rise 0.3s var(--ease-out-expo) 0.4s both;
  }
  /* после заставки кнопка пропуска не нужна */
  .hero[data-intro='done'] .skip {
    display: none;
  }
  .hero[data-intro='done'] .tile,
  .hero[data-intro='done'] .liquid,
  .hero[data-intro='done'] .brand,
  .hero[data-intro='done'] .lead,
  .hero[data-intro='done'] .actions,
  .hero[data-intro='done'] .meta {
    animation: none;
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  @keyframes pour {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes brand-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .liquid,
    .brand,
    .lead,
    .actions,
    .meta,
    .skip {
      animation: none;
    }
    .skip {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .collage {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(6, 1fr);
      gap: 5px;
      padding: 5px;
    }
    .tile {
      border-radius: 11px;
    }
    .tile.big {
      border-radius: 16px;
    }
    .brand i {
      margin-left: 10px;
    }
    .skip {
      right: 50%;
      transform: translateX(50%);
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const KEY = 'savva-intro-seen';

  function finishIntro() {
    if (!hero || hero.dataset.intro === 'done') return;
    hero.dataset.intro = 'done';
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {
      /* приватный режим: заставка просто повторится */
    }
  }

  let seen = false;
  try {
    seen = sessionStorage.getItem(KEY) === '1';
  } catch {
    /* хранилище недоступно */
  }

  if (seen) {
    // За визит заставка показывается один раз
    if (hero) hero.dataset.intro = 'done';
  } else {
    // Помечаем как просмотренную, когда сцена доиграла
    setTimeout(finishIntro, 2600);
    document.querySelector('[data-skip-intro]')?.addEventListener('click', finishIntro);
    window.addEventListener('pointerdown', finishIntro, { once: true });
    window.addEventListener('keydown', finishIntro, { once: true });
    window.addEventListener('wheel', finishIntro, { once: true, passive: true });
  }
</script>
