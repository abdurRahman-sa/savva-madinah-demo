---
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import wordmark from '../assets/brand/savva-wordmark.svg?raw';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.footer;
---

<footer class="section">
  <div class="wrap">
    <div class="footer-grid grid grid-cols-2 gap-6">
      <div>
        <h4 class="mb-1.5 text-[13px] text-muted">{f.address}</h4>
        <p>{f.addressValue[0]}<br />{f.addressValue[1]}</p>
      </div>
      <div>
        <h4 class="mb-1.5 text-[13px] text-muted">{f.hours}</h4>
        <p>{f.hoursValue[0]}<br />{f.hoursValue[1]}</p>
      </div>
      <div>
        <h4 class="mb-1.5 text-[13px] text-muted">{f.phone}</h4>
        <p><a class="no-underline hover:text-red" href={cafe.phoneHref} dir="ltr">{cafe.phone}</a></p>
      </div>
      <div>
        <h4 class="mb-1.5 text-[13px] text-muted">{f.instagram}</h4>
        <p><a class="no-underline hover:text-red" href={cafe.instagramUrl} target="_blank" rel="noopener" dir="ltr">{cafe.instagramHandle}</a></p>
      </div>
      <div>
        <h4 class="mb-1.5 text-[13px] text-muted">{f.tiktok}</h4>
        <p><a class="no-underline hover:text-red" href={cafe.tiktokUrl} target="_blank" rel="noopener" dir="ltr">{cafe.tiktokHandle}</a></p>
      </div>
    </div>
    <p class="foot-brand mt-11">
      <span class="sr-only">Savva</span>
      <span class="foot-wordmark" aria-hidden="true" set:html={wordmark} />
      <i lang="ar" dir="rtl">سافا</i>
    </p>
  </div>
</footer>

<style>
  .footer-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.35fr 1.2fr repeat(3, minmax(0, 1fr));
    }
  }
  .foot-brand {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    line-height: 1;
  }
  .foot-wordmark {
    display: inline-flex;
    width: clamp(220px, 38vw, 440px);
    color: var(--color-ink);
    line-height: 0;
  }
  .foot-wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .foot-brand i {
    font-style: normal;
    font-size: clamp(22px, 2.2vw, 32px);
    color: var(--color-sage);
    margin-bottom: 0.08em;
  }
</style>
