---
import { Image } from 'astro:assets';
import { cafe, menuGroups } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import breakfastLaptop from '../assets/photos/breakfast-laptop.jpg';
import drinksShelf from '../assets/photos/cold-drinks-shelf.jpg';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.calm;
const m = t.menu;
---

<section class="calm" id="menu">
  <div class="wrap calm-grid grid items-start">
    <div>
      <p class="hand text-blush!">{c.hand}</p>
      <h2 class="h-section text-on-dark">{c.title}</h2>
      <p class="mt-4 max-w-[40ch] text-[17px] text-on-dark-soft">{c.lead}</p>
      <div class="mt-[22px] flex flex-wrap gap-2">
        <span class="calm-fact"><b>{cafe.reviewTopics.quietness}</b> {c.quietness}</span>
        <span class="calm-fact"><b>{cafe.reviewTopics.outdoorSeating}</b> {c.terrace}</span>
      </div>
      <div class="calm-photos mt-[30px] grid gap-3">
        <figure><Image src={breakfastLaptop} alt={c.photo1Alt} widths={[478]} sizes="(max-width: 980px) 55vw, 300px" /></figure>
        <figure><Image src={drinksShelf} alt={c.photo2Alt} widths={[477]} sizes="(max-width: 980px) 45vw, 230px" /></figure>
      </div>
    </div>

    <div>
      <h3 class="font-display text-[clamp(34px,4vw,52px)] leading-none font-semibold">{m.title}</h3>
      <div class="groups mt-5 flex flex-wrap gap-2" role="tablist" aria-label={m.tabsLabel}>
        {
          menuGroups.map((g, i) => (
            <button
              type="button"
              role="tab"
              id={`menu-tab-${g.id}`}
              aria-controls={`menu-${g.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-group={g.id}
            >
              {m.groups[g.id]}
            </button>
          ))
        }
      </div>
      {
        menuGroups.map((g, i) => (
          <ul class="menu-list mt-[18px]" role="tabpanel" id={`menu-${g.id}`} aria-labelledby={`menu-tab-${g.id}`} hidden={i !== 0}>
            {g.items.map((item) => (
              <li>
                <b>
                  {item.ru}
                  <small>{item.kcal !== undefined ? `${item.kcal} ${m.kcal}` : item.note}</small>
                </b>
                {item.price !== undefined ? <span class="n">{item.price}</span> : <span class="n ask">{m.askPrice}</span>}
              </li>
            ))}
          </ul>
        ))
      }
      <p class="mt-[18px] max-w-[56ch] text-sm text-on-dark-soft">{m.note}</p>
    </div>
  </div>
</section>

<style>
  .calm {
    background: var(--color-shade);
    color: var(--color-on-dark);
    border-radius: calc(var(--radius-block) * 1.1);
    margin-inline: 14px;
    padding-block: var(--block-pad);
  }
  .calm-grid {
    grid-template-columns: 0.85fr 1.15fr;
    gap: 56px;
  }
  .calm-fact {
    border: 1.5px solid rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 14.5px;
    color: var(--color-on-dark-soft);
  }
  .calm-fact b {
    color: var(--color-on-dark);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .calm-photos {
    grid-template-columns: 1.3fr 1fr;
  }
  .calm-photos figure {
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .calm-photos figure:last-child {
    margin-top: 40px;
  }
  .calm-photos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .groups button {
    font: 500 15px/1 var(--font-sans);
    color: var(--color-on-dark);
    background: transparent;
    border: 0;
    box-shadow: inset 0 0 0 1.5px rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 12px 18px;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out-expo),
      box-shadow 0.25s var(--ease-out-expo);
  }
  .groups button:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-on-dark);
  }
  .groups button[aria-selected='true'] {
    background: var(--color-red);
    box-shadow: none;
    color: #fff;
  }
  .menu-list {
    border-top: 1px solid rgb(247 239 224 / 0.2);
  }
  .menu-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid rgb(247 239 224 / 0.2);
  }
  .menu-list b {
    font-weight: 400;
    font-size: 17.5px;
  }
  .menu-list small {
    display: block;
    color: var(--color-on-dark-soft);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    margin-top: 1px;
  }
  .n {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 27px;
    font-variant-numeric: tabular-nums;
  }
  .n.ask {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14px;
    color: var(--color-on-dark-soft);
  }

  @media (max-width: 980px) {
    .calm-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 640px) {
    .calm {
      margin-inline: 8px;
      border-radius: 26px;
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-group]')];
  function select(tab: HTMLButtonElement) {
    tabs.forEach((b) => {
      const on = b === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      document.getElementById(`menu-${b.dataset.group}`)!.hidden = !on;
    });
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
