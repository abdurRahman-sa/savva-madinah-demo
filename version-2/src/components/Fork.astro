---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { cafe, menu } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import driveThrough from '../assets/photos/drive-through-tray.jpg';
import coldTrio from '../assets/photos/cold-drinks-trio.jpg';
import terrace from '../assets/photos/terrace-day.jpg';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.fork;
const quick = [menu.americano, menu.latte, menu.hibiscus, menu.spanishLatte];
const doors = [
  { id: 'takeaway', icon: 'car' },
  { id: 'order', icon: 'bag' },
  { id: 'visit', icon: 'chair' },
] as const;
const photoSizes = '(max-width: 980px) 100vw, 520px';
---

<section class="section" id="fork">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="hand">{f.hand}</p>
        <h2 class="h-section">{f.title}</h2>
      </div>
      <OpenStatus t={t} />
    </div>

    <div class="doors mt-[34px] grid gap-3" role="tablist" aria-label={f.tabsLabel}>
      {
        doors.map((door, i) => (
          <button
            class="door"
            type="button"
            role="tab"
            id={`tab-${door.id}`}
            aria-controls={`panel-${door.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-door={door.id}
          >
            <Icon name={door.icon} class="door-icon" />
            <h3 class="font-display font-semibold">{f.doors[door.id].title}</h3>
            <p>{f.doors[door.id].text}</p>
          </button>
        ))
      }
    </div>

    <!-- Забрать с собой -->
    <div class="panel" role="tabpanel" id="panel-takeaway" aria-labelledby="tab-takeaway">
      <figure class="panel-photo">
        <Image src={driveThrough} alt={f.takeaway.photoAlt} widths={[400, 518]} sizes={photoSizes} class="size-full object-cover" />
        <figcaption>{f.takeaway.caption}</figcaption>
      </figure>
      <div>
        <h3 class="panel-title">{f.takeaway.title}</h3>
        <p class="panel-sub">{f.takeaway.text}</p>
        <ul class="facts">
          <li><span>{f.takeaway.address}</span>{f.takeaway.addressValue}</li>
          <li><span>{f.takeaway.plusCode}</span><bdi dir="ltr">{cafe.plusCode}</bdi></li>
          <li><span>{f.takeaway.hours}</span>{f.takeaway.hoursValue}</li>
        </ul>
        <div class="mt-[22px] flex flex-wrap gap-2.5">
          <a class="btn" href={cafe.routeUrl} target="_blank" rel="noopener">
            <Icon name="pin" strokeWidth={1.8} />
            {f.takeaway.route}
          </a>
          <a class="btn btn-line" href={cafe.phoneHref}>{f.takeaway.call}</a>
        </div>
        <div class="mt-[26px]">
          <h4 class="font-display text-[22px] font-semibold">{f.takeaway.quick}</h4>
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {
              quick.map((item) => (
                <li class="quick-item">
                  {item.ru} <b>{item.price}</b>
                </li>
              ))
            }
          </ul>
          <a class="textlink" href="#menu">{f.takeaway.allMenu}</a>
        </div>
      </div>
    </div>

    <!-- Заказать -->
    <div class="panel" role="tabpanel" id="panel-order" aria-labelledby="tab-order" hidden>
      <figure class="panel-photo">
        <Image src={coldTrio} alt={f.order.photoAlt} widths={[400, 477]} sizes={photoSizes} class="size-full object-cover" />
        <figcaption>{f.order.caption}</figcaption>
      </figure>
      <div>
        <h3 class="panel-title">{f.order.title}</h3>
        <p class="panel-sub">{f.order.text}</p>
        <form class="demo-form" novalidate>
          <div class="fields">
            <label class="field-label" for="order-name">{f.name}<input class="field" id="order-name" name="name" type="text" autocomplete="name" required /></label>
            <label class="field-label" for="order-phone">{f.phone}<input class="field" id="order-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
            <label class="field-label wide" for="order-address">{f.order.address}<input class="field" id="order-address" name="address" type="text" autocomplete="street-address" required /></label>
            <label class="field-label wide" for="order-items">{f.order.items}<textarea class="field min-h-[84px] resize-y" id="order-items" name="items" rows="3" placeholder={f.order.itemsPlaceholder} required></textarea></label>
          </div>
          <div class="mt-[22px] flex flex-wrap gap-2.5">
            <button class="btn" type="submit">{f.order.submit}</button>
            <a class="btn btn-line" href="#menu">{f.order.openMenu}</a>
          </div>
          <p class="demo-note">{f.order.note}</p>
        </form>
        <div class="ok" hidden>
          <h4 tabindex="-1">{f.order.okTitle}</h4>
          <p>{f.order.okText}</p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
        </div>
      </div>
    </div>

    <!-- Прийти -->
    <div class="panel" role="tabpanel" id="panel-visit" aria-labelledby="tab-visit" hidden>
      <figure class="panel-photo">
        <Image src={terrace} alt={f.visit.photoAlt} widths={[500, 800, 1000]} sizes={photoSizes} class="size-full object-cover object-[50%_62%]" />
        <figcaption>{f.visit.caption}</figcaption>
      </figure>
      <div>
        <h3 class="panel-title">{f.visit.title}</h3>
        <p class="panel-sub">{f.visit.text}</p>
        <form class="demo-form" novalidate>
          <div class="fields">
            <fieldset class="field-label wide">
              <legend class="mb-1.5">{f.visit.zone}</legend>
              <div class="seg">
                <label><input type="radio" name="zone" value="hall" checked /><span>{f.visit.hall}</span></label>
                <label><input type="radio" name="zone" value="terrace" /><span>{f.visit.terrace}</span></label>
              </div>
            </fieldset>
            <label class="field-label" for="visit-name">{f.name}<input class="field" id="visit-name" name="name" type="text" autocomplete="name" required /></label>
            <label class="field-label" for="visit-phone">{f.phone}<input class="field" id="visit-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
            <label class="field-label" for="visit-date">{f.visit.date}<input class="field" id="visit-date" name="date" type="date" required /></label>
            <label class="field-label" for="visit-time">{f.visit.time}<input class="field" id="visit-time" name="time" type="time" required /></label>
            <label class="field-label" for="visit-guests">{f.visit.guests}
              <select class="field" id="visit-guests" name="guests">
                {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option selected={n === 2}>{n}</option>)}
              </select>
            </label>
            <label class="check wide" for="visit-preorder"><input id="visit-preorder" type="checkbox" name="preorder" data-preorder />{f.visit.preorder}</label>
            <label class="field-label wide" for="visit-items" data-preorder-field hidden>{f.visit.items}<textarea class="field min-h-[84px] resize-y" id="visit-items" name="items" rows="3" placeholder={f.visit.itemsPlaceholder}></textarea></label>
          </div>
          <div class="mt-[22px] flex flex-wrap gap-2.5">
            <button class="btn" type="submit">{f.visit.submit}</button>
            <a class="btn btn-line" href="#menu" data-preorder-field hidden>{f.visit.openMenu}</a>
          </div>
          <p class="demo-note">{f.visit.note}</p>
        </form>
        <div class="ok" hidden>
          <h4 tabindex="-1">{f.visit.okTitle}</h4>
          <p>{f.visit.okText}</p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .doors {
    grid-template-columns: repeat(3, 1fr);
  }
  .door {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    border: 0;
    border-radius: calc(var(--radius-block) * 0.82);
    padding: 24px 26px 26px;
    background: var(--color-cream);
    display: grid;
    gap: 6px;
    align-content: start;
    position: relative;
    overflow: hidden;
    transition:
      background-color calc(0.35s * var(--motion)) var(--ease),
      color calc(0.35s * var(--motion)) var(--ease),
      transform calc(0.35s * var(--motion)) var(--ease);
  }
  .door:hover {
    transform: translateY(-3px);
  }
  .door h3 {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
  }
  .door p {
    font-size: 15px;
    color: var(--color-muted);
    max-width: 30ch;
  }
  .door :global(.door-icon) {
    width: 34px;
    height: 34px;
    color: var(--color-red);
    margin-bottom: 10px;
    transition: color 0.35s var(--ease-out-expo);
  }
  .door[aria-selected='true'] {
    background: var(--color-red);
    color: #fff;
  }
  .door[aria-selected='true'] p {
    color: #fbe3dc;
  }
  .door[aria-selected='true'] :global(.door-icon) {
    color: #fff;
  }
  .door[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-cream) 0 22px,
      transparent 22px 38px,
      var(--color-coffee) 38px 52px,
      transparent 52px 68px
    );
  }

  .panel {
    margin-top: 12px;
    background: var(--color-cream);
    border-radius: var(--radius-block);
    padding: 36px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: start;
  }
  .panel-photo {
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: var(--color-linen);
    position: relative;
  }
  .panel-photo figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: var(--color-cream);
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 13px;
    color: var(--color-coffee-deep);
  }
  .panel-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.05;
    text-wrap: balance;
  }
  .panel-sub {
    color: var(--color-muted);
    margin-top: 10px;
    max-width: 48ch;
  }
  .facts {
    margin-top: 22px;
    border-top: 1px solid var(--color-line);
  }
  .facts li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
  }
  .facts span {
    color: var(--color-muted);
  }
  .quick-item {
    border: 1.5px solid var(--color-coffee);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 15px;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .quick-item b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-red-ink);
    font-variant-numeric: tabular-nums;
  }
  .textlink {
    font-weight: 500;
    color: var(--color-coffee);
    display: inline-block;
    margin-top: 14px;
  }
  .textlink:hover {
    color: var(--color-red);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 22px;
  }
  .wide {
    grid-column: 1 / -1;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .seg {
    display: inline-flex;
    background: var(--color-linen);
    border-radius: 999px;
    padding: 5px;
    gap: 5px;
    width: max-content;
    max-width: 100%;
  }
  .seg label {
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .seg span {
    display: block;
    font: 500 15px/1 var(--font-sans);
    color: var(--color-ink);
    padding: 12px 20px;
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease-out-expo),
      color 0.25s var(--ease-out-expo);
  }
  .seg input:checked + span {
    background: var(--color-red);
    color: #fff;
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    cursor: pointer;
  }
  .check input {
    width: 20px;
    height: 20px;
  }
  .demo-note {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 12px;
  }
  .ok h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
  }
  .ok p {
    color: var(--color-muted);
    margin-top: 8px;
    max-width: 44ch;
  }

  @media (max-width: 980px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 26px;
      gap: 26px;
    }
    .panel-photo {
      aspect-ratio: 16/11;
    }
  }
  @media (max-width: 720px) {
    .doors {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .door {
      padding: 18px 20px;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      align-items: center;
    }
    .door :global(.door-icon) {
      margin: 0;
      grid-row: span 2;
      width: 30px;
      height: 30px;
    }
    .door h3 {
      font-size: 28px;
    }
  }
  @media (max-width: 640px) {
    .fields {
      grid-template-columns: 1fr;
    }
    .facts li {
      grid-template-columns: 110px 1fr;
    }
    .panel {
      border-radius: 26px;
      padding: 20px;
    }
    .seg span {
      padding: 11px 16px;
    }
  }
</style>

<script>
  const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];

  function openDoor(door: HTMLButtonElement) {
    doors.forEach((d) => {
      const on = d === door;
      d.setAttribute('aria-selected', String(on));
      d.tabIndex = on ? 0 : -1;
      document.getElementById(`panel-${d.dataset.door}`)!.hidden = !on;
    });
  }

  doors.forEach((door, i) => {
    door.addEventListener('click', () => openDoor(door));
    door.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = doors[(i + step + doors.length) % doors.length];
      next.focus();
      openDoor(next);
    });
  });

  // Кнопки героя открывают нужную вкладку развилки
  document.querySelectorAll<HTMLAnchorElement>('[data-open-door]').forEach((link) => {
    link.addEventListener('click', () => {
      const door = doors.find((d) => d.dataset.door === link.dataset.openDoor);
      if (door) openDoor(door);
    });
  });

  // «Подать заказ к приходу» показывает поле заказа и ссылку на меню
  const preorder = document.querySelector<HTMLInputElement>('[data-preorder]');
  const togglePreorder = () =>
    document.querySelectorAll<HTMLElement>('[data-preorder-field]').forEach((el) => (el.hidden = !preorder?.checked));
  preorder?.addEventListener('change', togglePreorder);

  // Демо-формы: проверяем поля и показываем подтверждение, ничего не отправляя
  document.querySelectorAll<HTMLFormElement>('.demo-form').forEach((form) => {
    const ok = form.nextElementSibling as HTMLElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.hidden = true;
      ok.hidden = false;
      ok.querySelector('h4')?.focus();
    });
    ok.querySelector('[data-again]')?.addEventListener('click', () => {
      form.reset();
      togglePreorder();
      form.hidden = false;
      ok.hidden = true;
      form.querySelector<HTMLInputElement>('input:not([type="radio"])')?.focus();
    });
  });
</script>
