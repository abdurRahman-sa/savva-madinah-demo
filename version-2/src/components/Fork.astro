</style>

<script>
  import { cartLines, cartTotals, clearCart, onCart } from '../scripts/cart';

  const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];

  function openDoor(door: HTMLButtonElement) {
    doors.forEach((d) => {
      const on = d === door;
      d.setAttribute('aria-selected', String(on));
      d.tabIndex = on ? 0 : -1;
      document.getElementById(`panel-${d.dataset.door}`)!.hidden = !on;
    });
  }

  doors.forEach((door, i) => {
    door.addEventListener('click', () => openDoor(door));
    door.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = doors[(i + step + doors.length) % doors.length];
      next.focus();
      openDoor(next);
    });
  });

  // Кнопки героя открывают нужную вкладку развилки
  document.querySelectorAll<HTMLAnchorElement>('[data-open-door]').forEach((link) => {
    link.addEventListener('click', () => {
      const door = doors.find((d) => d.dataset.door === link.dataset.openDoor);
      if (door) openDoor(door);
    });
  });

  // Дата: ближайшие три дня. Время: получасовые слоты в часах работы этого дня.
  const dateSelect = document.querySelector<HTMLSelectElement>('[data-visit-date]');
  const timeSelect = document.querySelector<HTMLSelectElement>('[data-visit-time]');
  const TZ = 'Asia/Riyadh';
  const OPEN = 390;
  const OPEN_FRIDAY = 780;
  const CLOSE = 120; // 02:00 следующих суток

  function madinahNow() {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      weekday: 'short',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    return {
      iso: `${get('year')}-${get('month')}-${get('day')}`,
      minutes: Number(get('hour')) * 60 + Number(get('minute')),
      friday: get('weekday') === 'Fri',
    };
  }

  function fillTimes(dayIso: string, offset: number) {
    if (!timeSelect) return;
    const day = new Date(`${dayIso}T12:00:00Z`);
    const friday = day.getUTCDay() === 5;
    const opens = friday ? OPEN_FRIDAY : OPEN;
    const now = madinahNow().minutes;
    const options: string[] = [];
    for (let m = opens; m <= 24 * 60 + CLOSE; m += 30) {
      if (offset === 0 && m <= now + 30) continue;
      const h = Math.floor(m / 60) % 24;
      options.push(`${String(h).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
    }
    timeSelect.innerHTML = options.map((value) => `<option>${value}</option>`).join('');
    return options.length;
  }

  // Доставку заказывают до 01:00 включительно: час до закрытия уходит на дорогу, в 01:01 уже нельзя.
  // Пока можно: «как можно скорее» и получасовые слоты от ближайшего до 01:00.
  // Иначе — слоты следующего рабочего дня, с открытия до 01:00.
  const deliverySelect = document.querySelector<HTMLSelectElement>('[data-delivery-time]');
  const deliveryHint = document.querySelector<HTMLElement>('[data-delivery-hint]');
  if (deliverySelect && deliveryHint) {
    const DELIVERY = 60;
    const { minutes: now, friday } = madinahNow();
    const opens = friday ? OPEN_FRIDAY : OPEN;
    const afterMidnight = now < CLOSE;
    const open = afterMidnight || now >= opens;
    const close = afterMidnight ? CLOSE : 24 * 60 + CLOSE;
    const hhmm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
    const range = (from: number, to: number) => {
      const out: string[] = [];
      for (let m = from; m <= to; m += 30) out.push(hhmm(m));
      return out;
    };

    const soonest = Math.ceil(now / 30) * 30;
    const today = open && now <= close - DELIVERY;
    // после полуночи календарный день уже следующий, поэтому opens — открытие этого же дня
    const slots = today ? range(soonest, close - DELIVERY) : range(opens, 24 * 60 + CLOSE - DELIVERY);
    deliverySelect.innerHTML = [
      today ? `<option value="asap">${deliverySelect.dataset.asap}</option>` : '',
      ...slots.map((slot) => `<option>${slot}</option>`),
    ].join('');

    const last = hhmm(CLOSE - DELIVERY);
    deliveryHint.textContent = today
      ? deliveryHint.dataset.last!.replace('{last}', last)
      : deliveryHint.dataset.later!.replace('{first}', slots[0]).replace('{last}', last);
  }

  if (dateSelect && timeSelect) {
    const today = madinahNow();
    const labels = ['сегодня', 'завтра', 'послезавтра'];
    const days = [0, 1, 2].map((offset) => {
      const date = new Date(`${today.iso}T12:00:00Z`);
      date.setUTCDate(date.getUTCDate() + offset);
      const iso = date.toISOString().slice(0, 10);
      const human = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(date);
      return { iso, offset, label: `${labels[offset]}, ${human}` };
    });
    dateSelect.innerHTML = days.map((day) => `<option value="${day.iso}" data-offset="${day.offset}">${day.label}</option>`).join('');
    // Если на сегодня слотов уже нет, первым днём становится завтра
    if (!fillTimes(days[0].iso, 0)) {
      dateSelect.remove(0);
      fillTimes(dateSelect.value, Number(dateSelect.selectedOptions[0].dataset.offset));
    }
    dateSelect.addEventListener('change', () => {
      const option = dateSelect.selectedOptions[0];
      fillTimes(dateSelect.value, Number(option.dataset.offset));
    });
  }


  // Стрелка на фото зоны листает кадры по кругу
  document.querySelectorAll<HTMLButtonElement>('[data-next-slide]').forEach((button) => {
    button.addEventListener('click', () => {
      const slides = [...button.closest('figure')!.querySelectorAll<HTMLElement>('[data-slide]')];
      const current = slides.findIndex((slide) => slide.hasAttribute('data-active'));
      const next = (current + 1) % slides.length;
      slides.forEach((slide, i) => {
        slide.toggleAttribute('data-active', i === next);
        slide.setAttribute('aria-hidden', String(i !== next));
      });
      const figure = button.closest('figure')!;
      figure.querySelector<HTMLElement>('[data-frame]')!.style.aspectRatio = slides[next].dataset.ratio!;
      const caption = figure.querySelector('[data-slide-caption]');
      if (caption) caption.textContent = slides[next].dataset.caption ?? '';
    });
  });

  // Схема столиков: зона показывает свою схему, выбранный столик подписан рядом
  const picked = document.querySelector<HTMLElement>('[data-table-picked]');
  const plansEls = [...document.querySelectorAll<HTMLElement>('[data-plan]')];
  const showPicked = () => {
    const checked = document.querySelector<HTMLInputElement>('input[name="table"]:checked');
    if (picked) picked.textContent = checked ? `${picked.dataset.picked} ${checked.value}` : picked.dataset.any!;
  };
  const showZone = () => {
    const zone = document.querySelector<HTMLInputElement>('[data-zone]:checked')?.value ?? 'hall';
    document.querySelectorAll<HTMLElement>('[data-visit-photo]').forEach((photo) => {
      photo.hidden = photo.dataset.visitPhoto !== zone;
    });
    plansEls.forEach((plan) => {
      const on = plan.dataset.plan === zone;
      plan.hidden = !on;
      plan.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = !on;
        if (!on) input.checked = false;
      });
    });
    showPicked();
  };
  document.querySelectorAll('[data-zone]').forEach((input) => input.addEventListener('change', showZone));
  document.querySelectorAll('input[name="table"]').forEach((input) => input.addEventListener('change', showPicked));

  // Сводка заказа: то, что гость набрал в меню (src/scripts/cart.ts), видно в «Заказать»
  // и в «Прийти» при галочке «заказ к приходу»
  const preorder = document.querySelector<HTMLInputElement>('#visit-preorder');
  const money = (n: number) => `${n} SAR`;
  function renderLines(list: HTMLElement, total: HTMLElement) {
    const lines = cartLines();
    const { sum, unpriced } = cartTotals();
    list.innerHTML = '';
    lines.forEach(({ item, qty }) => {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.textContent = qty > 1 ? `${item.ru} × ${qty}` : item.ru;
      const price = document.createElement('b');
      price.textContent =
        item.price !== undefined ? money(item.price * qty) : item.priceText ? `${item.priceText} SAR` : list.dataset.atCounter ?? '';
      li.append(name, price);
      list.append(li);
    });
    total.hidden = !lines.length;
    total.textContent = lines.length
      ? `${total.dataset.label} ${money(sum)}${unpriced ? ` ${total.dataset.plus}` : ''}`
      : '';
  }
  function paintSummaries() {
    const empty = cartTotals().count === 0;
    document.querySelectorAll<HTMLElement>('[data-summary]').forEach((box) => {
      renderLines(box.querySelector('[data-summary-list]')!, box.querySelector('[data-summary-total]')!);
      box.querySelector<HTMLElement>('[data-summary-empty]')!.hidden = !empty;
      const link = box.querySelector<HTMLElement>('[data-summary-link]')!;
      link.textContent = empty ? link.dataset.pick! : link.dataset.edit!;
      if (!empty) box.querySelector<HTMLElement>('[data-summary-error]')!.hidden = true;
    });
    const visitSummary = document.querySelector<HTMLElement>('[data-preorder-summary]');
    if (visitSummary && preorder) visitSummary.hidden = !preorder.checked;
  }
  preorder?.addEventListener('change', paintSummaries);
  onCart(paintSummaries);

  // заказ, который уходит с формой: для доставки — всегда, для брони — только с галочкой
  const usesCart = (form: HTMLFormElement) => form.id === 'order-form' || (form.id === 'visit-form' && !!preorder?.checked);

  // Демо-формы: проверяем поля и показываем подтверждение с номером, ничего не отправляя.
  // Отправленная форма тоже помнится 15 минут: после обновления видно то же подтверждение.
  const submitted: Record<string, string> = {};
  function showOk(form: HTMLFormElement, number: string) {
    const ok = form.nextElementSibling as HTMLElement;
    ok.querySelector('[data-ok-number]')!.textContent = `${ok.dataset.numberLabel}: ${number}`;
    const list = ok.querySelector<HTMLElement>('[data-ok-list]')!;
    const total = ok.querySelector<HTMLElement>('[data-ok-total]')!;
    if (usesCart(form)) renderLines(list, total);
    else {
      list.innerHTML = '';
      total.hidden = true;
    }
    form.hidden = true;
    ok.hidden = false;
    // зона и схема стоят вне формы, но относятся к ней: прячем вместе
    document.querySelectorAll<HTMLElement>(`[data-part-of="${form.id}"]`).forEach((el) => (el.hidden = true));
  }
  function showForm(form: HTMLFormElement) {
    const ok = form.nextElementSibling as HTMLElement;
    document.querySelectorAll<HTMLElement>(`[data-part-of="${form.id}"]`).forEach((el) => (el.hidden = false));
    form.hidden = false;
    ok.hidden = true;
  }

  document.querySelectorAll<HTMLFormElement>('.demo-form').forEach((form) => {
    const ok = form.nextElementSibling as HTMLElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // без позиций из меню доставку (и заказ к приходу) не оформить
      if (usesCart(form) && cartTotals().count === 0) {
        const box = form.querySelector<HTMLElement>('[data-summary]')!;
        const error = box.querySelector<HTMLElement>('[data-summary-error]')!;
        error.textContent = box.dataset.needs!;
        error.hidden = false;
        box.querySelector<HTMLElement>('[data-summary-link]')!.focus();
        return;
      }
      const number = String(1000 + Math.floor(Math.random() * 9000));
      submitted[form.id] = number;
      showOk(form, number);
      ok.querySelector('h4')?.focus();
      saveDraft();
    });
    ok.querySelector('[data-again]')?.addEventListener('click', () => {
      if (usesCart(form)) clearCart();
      delete submitted[form.id];
      form.reset();
      showZone();
      showForm(form);
      paintSummaries();
      form.querySelector<HTMLInputElement>('input:not([type="radio"])')?.focus();
      saveDraft();
    });
  });

  // Черновик заказа и брони: поля, зона, столик, открытая вкладка и отправленные формы сохраняются
  // в этом браузере, переживают обновление страницы и живут 15 минут с последней правки. Никуда не уходят.
  const DRAFT_KEY = 'savva-order-draft';
  const DRAFT_TTL = 15 * 60 * 1000;
  // поля форм и то, что относится к форме брони снаружи (зона, столик)
  const draftFields = () => [
    ...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '#fork .demo-form input, #fork .demo-form select, #fork input[form="visit-form"]',
    ),
  ];
  const fieldKey = (el: HTMLInputElement | HTMLSelectElement) =>
    el instanceof HTMLInputElement && el.type === 'radio' ? `${el.name}=${el.value}` : el.id;

  type Draft = { savedAt: number; door?: string; submitted?: Record<string, string>; values: Record<string, string | boolean> };
  let expiry: number | undefined;

  function dropDraft() {
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      /* хранилище недоступно */
    }
  }

  function saveDraft() {
    const values: Draft['values'] = {};
    draftFields().forEach((el) => {
      const key = fieldKey(el);
      if (!key) return;
      if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox')) values[key] = el.checked;
      else values[key] = el.value;
    });
    const door = doors.find((d) => d.getAttribute('aria-selected') === 'true')?.dataset.door;
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ savedAt: Date.now(), door, submitted, values } satisfies Draft));
    } catch {
      return;
    }
    // после «Забыть» подпись снова говорит про 15 минут
    document.querySelectorAll<HTMLElement>('[data-kept-text]').forEach((text) => (text.textContent = text.dataset.text!));
    // через 15 минут без правок черновик стирается, даже если страница открыта
    clearTimeout(expiry);
    expiry = window.setTimeout(dropDraft, DRAFT_TTL);
  }

  function readDraft(): Draft | undefined {
    try {
      const draft = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? 'null') as Draft | null;
      if (!draft) return;
      if (Date.now() - draft.savedAt > DRAFT_TTL) {
        dropDraft();
        return;
      }
      return draft;
    } catch {
      return;
    }
  }

  function restoreDraft() {
    const draft = readDraft();
    if (!draft) return;
    const byKey = new Map(draftFields().map((el) => [fieldKey(el), el]));
    const set = (key: string) => {
      const el = byKey.get(key);
      const value = draft.values[key];
      if (!el || value === undefined) return;
      if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox')) el.checked = value === true;
      // в выпадающем списке значение ставим, только если такой вариант ещё есть (время могло пройти)
      else if (el instanceof HTMLSelectElement) {
        if ([...el.options].some((o) => o.value === value)) el.value = String(value);
      } else el.value = String(value);
    };
    // дата раньше времени: от даты зависит список слотов
    set('visit-date');
    dateSelect?.dispatchEvent(new Event('change'));
    // зона раньше столика: столики чужой зоны выключены
    Object.keys(draft.values).filter((k) => k.startsWith('zone=')).forEach(set);
    showZone();
    Object.keys(draft.values)
      .filter((k) => k !== 'visit-date' && !k.startsWith('zone='))
      .forEach(set);
    showPicked();
    const door = doors.find((d) => d.dataset.door === draft.door);
    if (door) openDoor(door);
    Object.entries(draft.submitted ?? {}).forEach(([id, number]) => {
      const form = document.getElementById(id);
      if (form instanceof HTMLFormElement) {
        submitted[id] = number;
        showOk(form, number);
      }
    });
    clearTimeout(expiry);
    expiry = window.setTimeout(dropDraft, Math.max(0, DRAFT_TTL - (Date.now() - draft.savedAt)));
  }

  restoreDraft();
  paintSummaries();
  const fork = document.getElementById('fork');
  fork?.addEventListener('input', saveDraft);
  fork?.addEventListener('change', saveDraft);
  doors.forEach((door) => door.addEventListener('click', saveDraft));

  // «Забыть мои данные»: стираем черновик и корзину, очищаем обе формы
  document.querySelectorAll<HTMLButtonElement>('[data-forget]').forEach((button) => {
    button.addEventListener('click', () => {
      clearTimeout(expiry);
      dropDraft();
      clearCart();
      Object.keys(submitted).forEach((id) => delete submitted[id]);
      document.querySelectorAll<HTMLFormElement>('#fork .demo-form').forEach((form) => {
        form.reset();
        showForm(form);
      });
      document.querySelectorAll<HTMLInputElement>('#fork input[form="visit-form"]').forEach((input) => {
        input.checked = input.defaultChecked;
      });
      dateSelect?.dispatchEvent(new Event('change'));
      showZone();
      paintSummaries();
      document.querySelectorAll<HTMLElement>('[data-kept-text]').forEach((text) => {
        text.textContent = button.dataset.done!;
      });
    });
  });
</script>
