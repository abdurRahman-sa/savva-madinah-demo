---
import Icon from './Icon.astro';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import PhotoGallery from './PhotoGallery.astro';
import takeaway1 from '../assets/photos/takeaway-1.jpg';
import takeaway2 from '../assets/photos/takeaway-2.jpg';
import order1 from '../assets/photos/order-1.jpg';
import order2 from '../assets/photos/order-2.jpg';
import order3 from '../assets/photos/order-3.jpg';
import order4 from '../assets/photos/order-4.jpg';
import hall1 from '../assets/photos/hall-1.jpg';
import hall2 from '../assets/photos/hall-2.jpg';
import terrace1 from '../assets/photos/terrace-1.jpg';
import terrace2 from '../assets/photos/terrace-2.jpg';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.fork;
const doors = [
  { id: 'takeaway', icon: 'car' },
  { id: 'order', icon: 'bag' },
  { id: 'visit', icon: 'chair' },
] as const;
const photoSizes = '(max-width: 980px) 100vw, 520px';

// Мини-схема брони: квадрат 5×5 клеток, столик стоит в клетке [ряд, колонка].
// Расстановка условная — настоящей планировки у нас нет, на схеме это подписано.
const plans = {
  hall: [
    [2, 1], [2, 3], [2, 5],
    [3, 2], [3, 4],
    [4, 1], [4, 3], [4, 5],
    [5, 2], [5, 4],
  ],
  terrace: [
    [2, 2], [2, 4],
    [4, 2], [4, 4],
  ],
} as const;
const visitGalleries = [
  {
    zone: 'hall',
    nextLabel: f.visit.nextHall,
    photos: [
      { src: hall1, alt: f.visit.hallPhotoAlt, focus: '50% 50%', caption: f.visit.hallCaption },
      { src: hall2, alt: f.visit.hall2PhotoAlt, focus: '50% 58%', caption: '' },
    ],
  },
  {
    zone: 'terrace',
    nextLabel: f.visit.nextTerrace,
    photos: [
      { src: terrace1, alt: f.visit.photoAlt, focus: '50% 60%', caption: f.visit.caption },
      { src: terrace2, alt: f.visit.terrace2PhotoAlt, focus: '50% 62%', caption: f.visit.caption },
    ],
  },
] as const;
const tableNumber = (zone: 'hall' | 'terrace', i: number) => (zone === 'hall' ? i + 1 : 11 + i);
---

<section class="section" id="fork">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="hand">{f.hand}</p>
        <h2 class="h-section">{f.title}</h2>
      </div>
    </div>

    <div class="doors mt-[34px] grid gap-3" role="tablist" aria-label={f.tabsLabel}>
      {
        doors.map((door, i) => (
          <button
            class="door"
            type="button"
            role="tab"
            id={`tab-${door.id}`}
            aria-controls={`panel-${door.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-door={door.id}
          >
            <Icon name={door.icon} class="door-icon" />
            <h3 class="font-display font-semibold">{f.doors[door.id].title}</h3>
            <p>{f.doors[door.id].text}</p>
          </button>
        ))
      }
    </div>

    <!-- Забрать с собой -->
    <div class="panel" role="tabpanel" id="panel-takeaway" aria-labelledby="tab-takeaway">
      <PhotoGallery
        photos={[
          { src: takeaway1, alt: f.takeaway.photoAlt, focus: '50% 45%', caption: f.takeaway.caption },
          { src: takeaway2, alt: f.takeaway.photo2Alt, focus: '50% 50%', caption: f.takeaway.caption },
        ]}
        nextLabel={f.takeaway.next}
        sizes={photoSizes}
      />
      <div>
        <h3 class="panel-title">{f.takeaway.title}</h3>
        <p class="panel-sub">{f.takeaway.text}</p>
        <ul class="facts">
          <li><span>{f.takeaway.address}</span>{f.takeaway.addressValue}</li>
          <li><span>{f.takeaway.hours}</span>{f.takeaway.hoursValue}</li>
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="btn" href={cafe.routeUrl} target="_blank" rel="noopener">
            <Icon name="pin" strokeWidth={1.8} />
            {f.takeaway.route}
          </a>
          <a class="btn btn-line" href={cafe.phoneHref}>{f.takeaway.call}</a>
          <a class="btn btn-line" href="#menu">{f.takeaway.allMenu}</a>
        </div>
      </div>
    </div>

    <!-- Заказать -->
    <div class="panel" role="tabpanel" id="panel-order" aria-labelledby="tab-order" hidden>
      <PhotoGallery
        photos={[
          { src: order1, alt: f.order.photo1Alt, focus: '50% 50%', caption: '' },
          { src: order2, alt: f.order.photo2Alt, focus: '50% 50%', caption: '' },
          { src: order3, alt: f.order.photo3Alt, focus: '50% 50%', caption: '' },
          { src: order4, alt: f.order.photo4Alt, focus: '50% 50%', caption: '' },
        ]}
        nextLabel={f.order.next}
        sizes={photoSizes}
      />
      <div>
        <h3 class="panel-title">{f.order.title}</h3>
        <p class="panel-sub">{f.order.text}</p>
        <form class="demo-form" novalidate>
          <div class="fields">
            <label class="field-label" for="order-name">{f.name}<input class="field" id="order-name" name="name" type="text" autocomplete="name" required /></label>
            <label class="field-label" for="order-phone">{f.phone}<input class="field" id="order-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
            <label class="field-label wide" for="order-address">{f.order.address}<input class="field" id="order-address" name="address" type="text" autocomplete="street-address" required /></label>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button class="btn" type="submit">{f.order.submit}</button>
            <a class="btn btn-line" href="#menu">{f.order.openMenu}</a>
          </div>
          <p class="demo-note">{f.order.note}</p>
        </form>
        <div class="ok" hidden>
          <h4 tabindex="-1">{f.order.okTitle}</h4>
          <p>{f.order.okText}</p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
        </div>
      </div>
    </div>

    <!-- Прийти -->
    <div class="panel" role="tabpanel" id="panel-visit" aria-labelledby="tab-visit" hidden>
      <!-- фото меняется вместе с зоной; в каждой зоне два кадра, стрелка листает -->
      {
        visitGalleries.map((gallery) => (
          <PhotoGallery
            photos={gallery.photos}
            nextLabel={gallery.nextLabel}
            sizes={photoSizes}
            zone={gallery.zone}
            hidden={gallery.zone !== 'hall'}
          />
        ))
      }
      <div>
        <h3 class="panel-title">{f.visit.title}</h3>
        <p class="panel-sub">{f.visit.text}</p>
        <form class="demo-form" novalidate>
          <div class="fields">
            <fieldset class="field-label wide">
              <legend class="mb-1.5">{f.visit.zone}</legend>
              <div class="seg">
                <label><input type="radio" name="zone" value="hall" checked data-zone /><span>{f.visit.hall}<small>{f.visit.hallCount}</small></span></label>
                <label><input type="radio" name="zone" value="terrace" data-zone /><span>{f.visit.terrace}<small>{f.visit.terraceCount}</small></span></label>
              </div>
            </fieldset>
            <fieldset class="field-label wide tables">
              <legend class="mb-1.5">{f.visit.table}</legend>
              <div class="tables-row">
                {
                  (['hall', 'terrace'] as const).map((zone) => (
                    <div
                      class:list={['plan', `plan-${zone}`]}
                      role="radiogroup"
                      aria-label={zone === 'hall' ? f.visit.planHallLabel : f.visit.planTerraceLabel}
                      data-plan={zone}
                      hidden={zone === 'terrace'}
                    >
                      {zone === 'hall' ? (
                        <>
                          <span class="counter">{f.visit.planCounter}</span>
                          <span class="entrance">{f.visit.planEntrance}</span>
                        </>
                      ) : (
                        <>
                          <span class="awning" aria-hidden="true" />
                          <span class="edge edge-top">{f.visit.planCafe}</span>
                          <span class="edge edge-bottom">{f.visit.planWalk}</span>
                        </>
                      )}
                      {plans[zone].map(([row, col], i) => (
                        <label class="table" style={`grid-row:${row};grid-column:${col}`}>
                          <input type="radio" name="table" value={tableNumber(zone, i)} disabled={zone === 'terrace'} />
                          <span>{tableNumber(zone, i)}</span>
                        </label>
                      ))}
                    </div>
                  ))
                }
                <div class="tables-side">
                  <p class="picked" aria-live="polite" data-table-picked data-any={f.visit.tableAny} data-picked={f.visit.tablePicked}>
                    {f.visit.tableAny}
                  </p>
                  <p class="hint">{f.visit.tableHint} {f.visit.planNote}</p>
                </div>
              </div>
            </fieldset>
            <label class="field-label" for="visit-name">{f.name}<input class="field" id="visit-name" name="name" type="text" autocomplete="name" required /></label>
            <label class="field-label" for="visit-phone">{f.phone}<input class="field" id="visit-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
            <!-- дата, время и гости стоят одной строкой: форма короче -->
            <label class="field-label third" for="visit-date">{f.visit.date}
              <select class="field" id="visit-date" name="date" data-visit-date></select>
            </label>
            <label class="field-label third" for="visit-time">{f.visit.time}
              <select class="field" id="visit-time" name="time" data-visit-time></select>
            </label>
            <label class="field-label third" for="visit-guests">{f.visit.guests}
              <select class="field" id="visit-guests" name="guests">
                {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option selected={n === 2}>{n}</option>)}
              </select>
            </label>
            <label class="check wide" for="visit-preorder"><input id="visit-preorder" type="checkbox" name="preorder" data-preorder />{f.visit.preorder}</label>
            <label class="field-label wide" for="visit-items" data-preorder-field hidden>{f.visit.items}<textarea class="field min-h-[84px] resize-y" id="visit-items" name="items" rows="3" placeholder={f.visit.itemsPlaceholder}></textarea></label>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button class="btn" type="submit">{f.visit.submit}</button>
            <a class="btn btn-line" href="#menu">{f.visit.openMenu}</a>
          </div>
          <p class="demo-note">{f.visit.note}</p>
        </form>
        <div class="ok" hidden>
          <h4 tabindex="-1">{f.visit.okTitle}</h4>
          <p>{f.visit.okText}</p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .doors {
    grid-template-columns: repeat(3, 1fr);
  }
  .door {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    border: 0;
    border-radius: calc(var(--radius-block) * 0.82);
    padding: 24px 26px 26px;
    background: var(--color-cream);
    display: grid;
    gap: 6px;
    align-content: start;
    position: relative;
    overflow: hidden;
    transition:
      background-color calc(0.35s * var(--motion)) var(--ease),
      color calc(0.35s * var(--motion)) var(--ease),
      transform calc(0.35s * var(--motion)) var(--ease);
  }
  .door:hover {
    transform: translateY(-3px);
  }
  .door h3 {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
  }
  .door p {
    font-size: 15px;
    color: var(--color-muted);
    max-width: 30ch;
  }
  .door :global(.door-icon) {
    width: 34px;
    height: 34px;
    color: var(--color-red);
    margin-bottom: 10px;
    transition: color 0.35s var(--ease-out-expo);
  }
  .door[aria-selected='true'] {
    background: var(--color-red);
    color: #fff;
  }
  .door[aria-selected='true'] p {
    color: #fbe3dc;
  }
  .door[aria-selected='true'] :global(.door-icon) {
    color: #fff;
  }
  .door[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-cream) 0 22px,
      transparent 22px 38px,
      var(--color-coffee) 38px 52px,
      transparent 52px 68px
    );
  }

  .panel {
    margin-top: 12px;
    background: var(--color-cream);
    border-radius: var(--radius-block);
    padding: 22px;
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 26px;
    align-items: start;
  }
  /* в «Прийти» фото шире: зал снят горизонтально и должен читаться целиком */
  #panel-visit {
    grid-template-columns: 1fr 1fr;
  }
  .panel-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.05;
    text-wrap: balance;
  }
  .panel-sub {
    color: var(--color-muted);
    margin-top: 8px;
    max-width: 52ch;
    font-size: 15px;
  }
  .facts {
    margin-top: 16px;
    border-top: 1px solid var(--color-line);
  }
  .facts li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 14px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 14.5px;
  }
  .facts span {
    color: var(--color-muted);
  }
  .textlink {
    font-weight: 500;
    color: var(--color-coffee);
    display: inline-block;
    margin-top: 14px;
  }
  .textlink:hover {
    color: var(--color-red);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-top: 16px;
  }
  .fields > * {
    grid-column: span 3;
  }
  /* дата, время и гости — одной строкой */
  .fields .third {
    grid-column: span 2;
  }
  .wide {
    grid-column: 1 / -1;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .seg {
    display: inline-flex;
    background: var(--color-linen);
    border-radius: 999px;
    padding: 5px;
    gap: 5px;
    width: max-content;
    max-width: 100%;
  }
  .seg label {
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .seg span {
    display: block;
    font: 500 15px/1 var(--font-sans);
    color: var(--color-ink);
    padding: 12px 20px;
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease-out-expo),
      color 0.25s var(--ease-out-expo);
  }
  .seg input:checked + span {
    background: var(--color-red);
    color: #fff;
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }
  .seg small {
    display: block;
    margin-top: 5px;
    font-size: 12.5px;
    font-weight: 400;
    opacity: 0.75;
  }

  /* мини-схема брони: квадрат средней величины, столики — круглые кнопки */
  .tables-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }
  .plan {
    position: relative;
    width: min(100%, 260px);
    aspect-ratio: 1;
    display: grid;
    grid-template: repeat(5, 1fr) / repeat(5, 1fr);
    place-items: center;
    padding: 12px;
    border-radius: 18px;
    background: var(--color-linen);
    box-shadow: inset 0 0 0 2px var(--color-line);
  }
  .plan[hidden] {
    display: none;
  }
  .counter {
    grid-row: 1;
    grid-column: 1 / 4;
    align-self: start;
    justify-self: stretch;
    padding: 5px 0;
    border-radius: 8px;
    background: var(--color-coffee);
    color: var(--color-cream);
    font-size: 11.5px;
    text-align: center;
  }
  .entrance,
  .edge {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 0 8px;
    font-size: 11.5px;
    color: var(--color-muted);
    background: var(--color-cream);
    border-radius: 999px;
    white-space: nowrap;
  }
  .entrance,
  .edge-bottom {
    bottom: -8px;
  }
  .edge-top {
    top: 16px;
  }
  /* навес над верандой — та же полоса, что в мире сайта */
  .awning {
    position: absolute;
    inset: 0 0 auto;
    height: 10px;
    border-radius: 18px 18px 0 0;
    background: repeating-linear-gradient(90deg, var(--color-red) 0 16px, var(--color-cream) 16px 32px);
  }
  .table {
    position: relative;
    cursor: pointer;
  }
  .table input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .table span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-cream);
    box-shadow: inset 0 0 0 1.5px var(--color-coffee);
    font: 500 14px/1 var(--font-sans);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    transition:
      background-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
  }
  .table:hover span {
    transform: scale(1.08);
  }
  .table input:checked + span {
    background: var(--color-red);
    color: #fff;
    box-shadow: none;
  }
  .table input:focus-visible + span {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
  }
  .tables-side {
    flex: 1 1 200px;
    max-width: 34ch;
  }
  .picked {
    font-weight: 500;
    color: var(--color-ink);
  }
  .hint {
    margin-top: 6px;
    font-size: 13px;
    color: var(--color-muted);
  }

  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    cursor: pointer;
  }
  .check input {
    width: 20px;
    height: 20px;
  }
  .demo-note {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 12px;
  }
  .ok h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
  }
  .ok p {
    color: var(--color-muted);
    margin-top: 8px;
    max-width: 44ch;
  }

  @media (max-width: 980px) {
    .panel,
    #panel-visit {
      grid-template-columns: 1fr;
      padding: 18px;
      gap: 18px;
    }
  }
  @media (max-width: 720px) {
    .doors {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .door {
      padding: 18px 20px;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      align-items: center;
    }
    .door :global(.door-icon) {
      margin: 0;
      grid-row: span 2;
      width: 30px;
      height: 30px;
    }
    .door h3 {
      font-size: 28px;
    }
  }
  @media (max-width: 640px) {
    .fields > * {
      grid-column: 1 / -1;
    }
    .fields .third {
      grid-column: span 2;
    }
    .facts li {
      grid-template-columns: 110px 1fr;
    }
    .panel {
      border-radius: 26px;
      padding: 20px;
    }
    .seg span {
      padding: 11px 16px;
    }
    .plan {
      width: min(100%, 240px);
    }
    .table span {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];

  function openDoor(door: HTMLButtonElement) {
    doors.forEach((d) => {
      const on = d === door;
      d.setAttribute('aria-selected', String(on));
      d.tabIndex = on ? 0 : -1;
      document.getElementById(`panel-${d.dataset.door}`)!.hidden = !on;
    });
  }

  doors.forEach((door, i) => {
    door.addEventListener('click', () => openDoor(door));
    door.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = doors[(i + step + doors.length) % doors.length];
      next.focus();
      openDoor(next);
    });
  });

  // Кнопки героя открывают нужную вкладку развилки
  document.querySelectorAll<HTMLAnchorElement>('[data-open-door]').forEach((link) => {
    link.addEventListener('click', () => {
      const door = doors.find((d) => d.dataset.door === link.dataset.openDoor);
      if (door) openDoor(door);
    });
  });

  // Дата: ближайшие три дня. Время: получасовые слоты в часах работы этого дня.
  const dateSelect = document.querySelector<HTMLSelectElement>('[data-visit-date]');
  const timeSelect = document.querySelector<HTMLSelectElement>('[data-visit-time]');
  const TZ = 'Asia/Riyadh';
  const OPEN = 390;
  const OPEN_FRIDAY = 780;
  const CLOSE = 120; // 02:00 следующих суток

  function madinahNow() {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      weekday: 'short',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    return {
      iso: `${get('year')}-${get('month')}-${get('day')}`,
      minutes: Number(get('hour')) * 60 + Number(get('minute')),
    };
  }

  function fillTimes(dayIso: string, offset: number) {
    if (!timeSelect) return;
    const day = new Date(`${dayIso}T12:00:00Z`);
    const friday = day.getUTCDay() === 5;
    const opens = friday ? OPEN_FRIDAY : OPEN;
    const now = madinahNow().minutes;
    const options: string[] = [];
    for (let m = opens; m <= 24 * 60 + CLOSE; m += 30) {
      if (offset === 0 && m <= now + 30) continue;
      const h = Math.floor(m / 60) % 24;
      options.push(`${String(h).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
    }
    timeSelect.innerHTML = options.map((value) => `<option>${value}</option>`).join('');
    return options.length;
  }

  if (dateSelect && timeSelect) {
    const today = madinahNow();
    const labels = ['сегодня', 'завтра', 'послезавтра'];
    const days = [0, 1, 2].map((offset) => {
      const date = new Date(`${today.iso}T12:00:00Z`);
      date.setUTCDate(date.getUTCDate() + offset);
      const iso = date.toISOString().slice(0, 10);
      const human = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(date);
      return { iso, offset, label: `${labels[offset]}, ${human}` };
    });
    dateSelect.innerHTML = days.map((day) => `<option value="${day.iso}" data-offset="${day.offset}">${day.label}</option>`).join('');
    // Если на сегодня слотов уже нет, первым днём становится завтра
    if (!fillTimes(days[0].iso, 0)) {
      dateSelect.remove(0);
      fillTimes(dateSelect.value, Number(dateSelect.selectedOptions[0].dataset.offset));
    }
    dateSelect.addEventListener('change', () => {
      const option = dateSelect.selectedOptions[0];
      fillTimes(dateSelect.value, Number(option.dataset.offset));
    });
  }

  // «Подать заказ к приходу» показывает поле заказа и ссылку на меню
  const preorder = document.querySelector<HTMLInputElement>('[data-preorder]');
  const togglePreorder = () =>
    document.querySelectorAll<HTMLElement>('[data-preorder-field]').forEach((el) => (el.hidden = !preorder?.checked));
  preorder?.addEventListener('change', togglePreorder);

  // Стрелка на фото зоны листает кадры по кругу
  document.querySelectorAll<HTMLButtonElement>('[data-next-slide]').forEach((button) => {
    button.addEventListener('click', () => {
      const slides = [...button.closest('figure')!.querySelectorAll<HTMLElement>('[data-slide]')];
      const current = slides.findIndex((slide) => slide.hasAttribute('data-active'));
      const next = (current + 1) % slides.length;
      slides.forEach((slide, i) => {
        slide.toggleAttribute('data-active', i === next);
        slide.setAttribute('aria-hidden', String(i !== next));
      });
      const figure = button.closest('figure')!;
      figure.querySelector<HTMLElement>('[data-frame]')!.style.aspectRatio = slides[next].dataset.ratio!;
      const caption = figure.querySelector('[data-slide-caption]');
      if (caption) caption.textContent = slides[next].dataset.caption ?? '';
    });
  });

  // Схема столиков: зона показывает свою схему, выбранный столик подписан рядом
  const picked = document.querySelector<HTMLElement>('[data-table-picked]');
  const plansEls = [...document.querySelectorAll<HTMLElement>('[data-plan]')];
  const showPicked = () => {
    const checked = document.querySelector<HTMLInputElement>('input[name="table"]:checked');
    if (picked) picked.textContent = checked ? `${picked.dataset.picked} ${checked.value}` : picked.dataset.any!;
  };
  const showZone = () => {
    const zone = document.querySelector<HTMLInputElement>('[data-zone]:checked')?.value ?? 'hall';
    document.querySelectorAll<HTMLElement>('[data-visit-photo]').forEach((photo) => {
      photo.hidden = photo.dataset.visitPhoto !== zone;
    });
    plansEls.forEach((plan) => {
      const on = plan.dataset.plan === zone;
      plan.hidden = !on;
      plan.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = !on;
        if (!on) input.checked = false;
      });
    });
    showPicked();
  };
  document.querySelectorAll('[data-zone]').forEach((input) => input.addEventListener('change', showZone));
  document.querySelectorAll('input[name="table"]').forEach((input) => input.addEventListener('change', showPicked));

  // Демо-формы: проверяем поля и показываем подтверждение, ничего не отправляя
  document.querySelectorAll<HTMLFormElement>('.demo-form').forEach((form) => {
    const ok = form.nextElementSibling as HTMLElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.hidden = true;
      ok.hidden = false;
      ok.querySelector('h4')?.focus();
    });
    ok.querySelector('[data-again]')?.addEventListener('click', () => {
      form.reset();
      togglePreorder();
      showZone();
      form.hidden = false;
      ok.hidden = true;
      form.querySelector<HTMLInputElement>('input:not([type="radio"])')?.focus();
    });
  });
</script>
