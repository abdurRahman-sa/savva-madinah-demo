  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    cursor: pointer;
  }
  .check input {
    width: 20px;
    height: 20px;
  }
  .demo-note {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 12px;
  }
  /* сводка заказа из меню: позиции, суммы, итог */
  .summary {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--color-linen);
