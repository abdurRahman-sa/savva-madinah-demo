---
import Icon from './Icon.astro';
import { cafe } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import PhotoGallery from './PhotoGallery.astro';
import takeaway1 from '../assets/photos/takeaway-1.jpg';
import takeaway2 from '../assets/photos/takeaway-2.jpg';
import order1 from '../assets/photos/order-1.jpg';
import order2 from '../assets/photos/order-2.jpg';
import order3 from '../assets/photos/order-3.jpg';
import order4 from '../assets/photos/order-4.jpg';
import hall1 from '../assets/photos/hall-1.jpg';
import hall2 from '../assets/photos/hall-2.jpg';
import terrace1 from '../assets/photos/terrace-1.jpg';
import terrace2 from '../assets/photos/terrace-2.jpg';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const f = t.fork;
const c = t.cart;
const doors = [
  { id: 'takeaway', icon: 'car' },
  { id: 'order', icon: 'bag' },
  { id: 'visit', icon: 'chair' },
] as const;
const photoSizes = '(max-width: 720px) 100vw, (max-width: 980px) 40vw, 520px';

// Мини-схема брони: квадрат 5×5 клеток, столик стоит в клетке [ряд, колонка].
// Расстановка условная — настоящей планировки у нас нет, на схеме это подписано.
const plans = {
  hall: [
    [2, 1], [2, 3], [2, 5],
    [3, 2], [3, 4],
    [4, 1], [4, 3], [4, 5],
    [5, 2], [5, 4],
  ],
  terrace: [
    [2, 2], [2, 4],
    [4, 2], [4, 4],
  ],
} as const;
const visitGalleries = [
  {
    zone: 'hall',
    nextLabel: f.visit.nextHall,
    photos: [
      { src: hall1, alt: f.visit.hallPhotoAlt, focus: '50% 50%', caption: f.visit.hallCaption },
      { src: hall2, alt: f.visit.hall2PhotoAlt, focus: '50% 58%', caption: '' },
    ],
  },
  {
    zone: 'terrace',
    nextLabel: f.visit.nextTerrace,
    photos: [
      { src: terrace1, alt: f.visit.photoAlt, focus: '50% 60%', caption: f.visit.caption },
      { src: terrace2, alt: f.visit.terrace2PhotoAlt, focus: '50% 62%', caption: f.visit.caption },
    ],
  },
] as const;
const tableNumber = (zone: 'hall' | 'terrace', i: number) => (zone === 'hall' ? i + 1 : 11 + i);
---

<section class="section fork" id="fork" data-bg="sage" data-bg-default="sage">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="hand">{f.hand}</p>
        <h2 class="h-section">{f.title}</h2>
      </div>
    </div>

    <div class="doors mt-[34px] grid gap-3" role="tablist" aria-label={f.tabsLabel}>
      {
        doors.map((door, i) => (
          <button
            class="door"
            type="button"
            role="tab"
            id={`tab-${door.id}`}
            aria-controls={`panel-${door.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-door={door.id}
          >
            <Icon name={door.icon} class="door-icon" />
            <h3 class="font-display font-semibold">{f.doors[door.id].title}</h3>
            <p>{f.doors[door.id].text}</p>
          </button>
        ))
      }
    </div>

    <!-- Забрать с собой -->
    <div class="panel" role="tabpanel" id="panel-takeaway" aria-labelledby="tab-takeaway">
      <PhotoGallery
        photos={[
          { src: takeaway1, alt: f.takeaway.photoAlt, focus: '50% 45%', caption: f.takeaway.caption },
          { src: takeaway2, alt: f.takeaway.photo2Alt, focus: '50% 50%', caption: f.takeaway.caption },
        ]}
        nextLabel={f.takeaway.next}
        sizes={photoSizes}
      />
      <div>
        <h3 class="panel-title">{f.takeaway.title}</h3>
        <p class="panel-sub">{f.takeaway.text}</p>
        <ul class="facts">
          <li><span>{f.takeaway.address}</span>{f.takeaway.addressValue}</li>
          <li><span>{f.takeaway.hours}</span>{f.takeaway.hoursValue}</li>
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="btn" href={cafe.routeUrl} target="_blank" rel="noopener">
            <Icon name="pin" />
            {f.takeaway.route}
          </a>
          <a class="btn btn-line" href={cafe.phoneHref}>{f.takeaway.call}</a>
          <a class="btn btn-line" href="#menu">{f.takeaway.openMenu}</a>
        </div>
      </div>
    </div>

    <!-- Заказать -->
    <div class="panel" role="tabpanel" id="panel-order" aria-labelledby="tab-order" hidden>
      <PhotoGallery
        photos={[
          { src: order1, alt: f.order.photo1Alt, focus: '50% 50%', caption: '' },
          { src: order2, alt: f.order.photo2Alt, focus: '50% 50%', caption: '' },
          { src: order3, alt: f.order.photo3Alt, focus: '50% 50%', caption: '' },
          { src: order4, alt: f.order.photo4Alt, focus: '50% 50%', caption: '' },
        ]}
        nextLabel={f.order.next}
        sizes={photoSizes}
      />
      <div>
        <h3 class="panel-title">{f.order.title}</h3>
        <p class="panel-sub">{f.order.text}</p>
        <form class="demo-form" id="order-form" novalidate>
          <div class="fields">
            <label class="field-label" for="order-name">{f.name}<input class="field" id="order-name" name="name" type="text" autocomplete="name" required /></label>
            <label class="field-label" for="order-phone">{f.phone}<input class="field" id="order-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
            <label class="field-label address" for="order-address">{f.order.address}<input class="field" id="order-address" name="address" type="text" autocomplete="street-address" required /></label>
            <label class="field-label when" for="order-time">{f.order.time}
              <select class="field" id="order-time" name="time" data-delivery-time data-asap={f.order.asap} aria-describedby="order-time-hint"></select>
            </label>
            <p class="time-hint wide" id="order-time-hint" data-delivery-hint data-last={f.order.lastHint} data-later={f.order.laterHint}></p>
          </div>
          <div class="summary" data-summary data-needs={c.needItems}>
            <p class="summary-title">{c.title}</p>
            <ul class="summary-list" data-summary-list data-at-counter={c.atCounter}></ul>
            <p class="summary-total" data-summary-total data-label={c.total} data-plus={c.plusCounter} hidden></p>
            <p class="summary-empty" data-summary-empty>{c.empty}</p>
            <a class="summary-link" href="#menu" data-summary-link data-pick={c.pick} data-edit={c.edit}>{c.pick}</a>
            <p class="summary-error" data-summary-error role="alert" hidden></p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button class="btn" type="submit">{f.order.submit}</button>
            <a class="btn btn-line" href="#menu">{f.order.openMenu}</a>
          </div>
          <p class="demo-note">{f.order.note}</p>
          <p class="demo-note kept">
            <span data-kept-text data-text={f.kept}>{f.kept}</span>
            <button type="button" class="forget" data-forget data-done={f.forgotten}>{f.forget}</button>
          </p>
        </form>
        <div class="ok" hidden data-number-label={c.number}>
          <h4 tabindex="-1">{f.order.okTitle}</h4>
          <p>{f.order.okText}</p>
          <p class="ok-number" data-ok-number></p>
          <ul class="summary-list" data-ok-list data-at-counter={c.atCounter}></ul>
          <p class="summary-total" data-ok-total data-label={c.total} data-plus={c.plusCounter}></p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
          <p class="demo-note kept">
            <span data-kept-text data-text={f.kept}>{f.kept}</span>
            <button type="button" class="forget" data-forget data-done={f.forgotten}>{f.forget}</button>
          </p>
        </div>
      </div>
    </div>

    <!-- Прийти. Слева всё про место: зона, фото, схема столиков; справа заголовок и короткая форма столбиком.
         Зона и столик вынесены из формы, но принадлежат ей через атрибут form. -->
    <div class="panel panel-visit" role="tabpanel" id="panel-visit" aria-labelledby="tab-visit" hidden>
      <div class="v-col">
        <!-- фото меняется вместе с зоной; в каждой зоне два кадра, стрелка листает -->
        {
          visitGalleries.map((gallery) => (
            <PhotoGallery
              photos={gallery.photos}
              nextLabel={gallery.nextLabel}
              sizes={photoSizes}
              zone={gallery.zone}
              hidden={gallery.zone !== 'hall'}
            />
          ))
        }
        <fieldset class="field-label tables v-tables" data-part-of="visit-form">
          <legend class="mb-1.5">{f.visit.table}</legend>
          <div class="tables-row">
            {
              (['hall', 'terrace'] as const).map((zone) => (
                <div
                  class:list={['plan', `plan-${zone}`]}
                  role="radiogroup"
                  aria-label={zone === 'hall' ? f.visit.planHallLabel : f.visit.planTerraceLabel}
                  data-plan={zone}
                  hidden={zone === 'terrace'}
                >
                  {zone === 'hall' ? (
                    <>
                      <span class="counter">{f.visit.planCounter}</span>
                      <span class="entrance">{f.visit.planEntrance}</span>
                    </>
                  ) : (
                    <>
                      <span class="awning" aria-hidden="true" />
                      <span class="edge edge-top">{f.visit.planCafe}</span>
                      <span class="edge edge-bottom">{f.visit.planWalk}</span>
                    </>
                  )}
                  {plans[zone].map(([row, col], i) => (
                    <label class="table" style={`grid-row:${row};grid-column:${col}`}>
                      <input type="radio" form="visit-form" name="table" value={tableNumber(zone, i)} disabled={zone === 'terrace'} />
                      <span>{tableNumber(zone, i)}</span>
                    </label>
                  ))}
                </div>
              ))
            }
            <div class="tables-side">
              <p class="picked" aria-live="polite" data-table-picked data-any={f.visit.tableAny} data-picked={f.visit.tablePicked}>
                {f.visit.tableAny}
              </p>
              <p class="hint">{f.visit.tableHint} {f.visit.planNote}</p>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="v-col">
        <div class="v-head">
          <h3 class="panel-title">{f.visit.title}</h3>
          <p class="panel-sub">{f.visit.text}</p>
        </div>
        <fieldset class="field-label v-zone" data-part-of="visit-form">
          <legend class="mb-1.5">{f.visit.zone}</legend>
          <div class="seg">
            <label><input type="radio" form="visit-form" name="zone" value="hall" checked data-zone /><span>{f.visit.hall}<small>{f.visit.hallCount}</small></span></label>
            <label><input type="radio" form="visit-form" name="zone" value="terrace" data-zone /><span>{f.visit.terrace}<small>{f.visit.terraceCount}</small></span></label>
          </div>
        </fieldset>
        <form class="demo-form v-form" id="visit-form" novalidate>
          <div class="fields">
          <label class="field-label wide" for="visit-name">{f.name}<input class="field" id="visit-name" name="name" type="text" autocomplete="name" required /></label>
          <label class="field-label wide" for="visit-phone">{f.phone}<input class="field" id="visit-phone" name="phone" type="tel" dir="ltr" autocomplete="tel" placeholder="+966 5X XXX XXXX" required /></label>
          <!-- поля столбиком: колонка формы выравнивается по высоте с фото и схемой -->
          <label class="field-label wide" for="visit-date">{f.visit.date}
            <select class="field" id="visit-date" name="date" data-visit-date></select>
          </label>
          <label class="field-label wide" for="visit-time">{f.visit.time}
            <select class="field" id="visit-time" name="time" data-visit-time></select>
          </label>
          <label class="field-label wide" for="visit-guests">{f.visit.guests}
            <select class="field" id="visit-guests" name="guests">
              {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option selected={n === 2}>{n}</option>)}
            </select>
          </label>
          <!-- что приготовить, гость выберет в общей форме заказа; здесь только отметка -->
          <label class="check wide" for="visit-preorder"><input id="visit-preorder" type="checkbox" name="preorder" />{f.visit.preorder}</label>
          </div>
          <div class="summary" data-summary data-needs={c.needPreorder} data-preorder-summary hidden>
            <p class="summary-title">{c.title}</p>
            <ul class="summary-list" data-summary-list data-at-counter={c.atCounter}></ul>
            <p class="summary-total" data-summary-total data-label={c.total} data-plus={c.plusCounter} hidden></p>
            <p class="summary-empty" data-summary-empty>{c.empty}</p>
            <a class="summary-link" href="#menu" data-summary-link data-pick={c.pick} data-edit={c.edit}>{c.pick}</a>
            <p class="summary-error" data-summary-error role="alert" hidden></p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button class="btn" type="submit">{f.visit.submit}</button>
            <a class="btn btn-line" href="#menu">{f.visit.openMenu}</a>
          </div>
          <p class="demo-note">{f.visit.note}</p>
          <p class="demo-note kept">
            <span data-kept-text data-text={f.kept}>{f.kept}</span>
            <button type="button" class="forget" data-forget data-done={f.forgotten}>{f.forget}</button>
          </p>
        </form>
        <div class="ok v-form" hidden data-number-label={c.bookingNumber}>
          <h4 tabindex="-1">{f.visit.okTitle}</h4>
          <p>{f.visit.okText}</p>
          <p class="ok-number" data-ok-number></p>
          <ul class="summary-list" data-ok-list data-at-counter={c.atCounter}></ul>
          <p class="summary-total" data-ok-total data-label={c.total} data-plus={c.plusCounter}></p>
          <button class="btn btn-line mt-5" type="button" data-again>{f.again}</button>
          <p class="demo-note kept">
            <span data-kept-text data-text={f.kept}>{f.kept}</span>
            <button type="button" class="forget" data-forget data-done={f.forgotten}>{f.forget}</button>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .doors {
    grid-template-columns: repeat(3, 1fr);
  }
  /* Фон блока — шалфей (выбор пользователя 2026-09-19). Остальные варианты — для примерки:
     панель твиков меняет data-bg на секции; 'none' — песочный фон страницы. */
  .fork {
    /* ритм развилки отдельно от остальных блоков */
    --block-pad: var(--fork-pad);
    --block-gap: var(--fork-gap);
    position: relative;
    transition: background-color calc(0.35s * var(--motion)) var(--ease);
  }
  /* сливочная полоса: карточки внутри становятся песочными, панель — светлее */
  .fork[data-bg='cream'] {
    background: var(--color-cream);
  }
  .fork[data-bg='cream'] .door:not([aria-selected='true']) {
    background: var(--color-linen);
  }
  .fork[data-bg='cream'] .panel {
    background: #fffaf2;
  }
  /* тёмные варианты: заголовок светлый, рукописное слово — нежно-розовое */
  .fork[data-bg='shade'] {
    background: var(--color-shade);
  }
  .fork[data-bg='sage'] {
    background: var(--color-sage);
  }
  .fork[data-bg='shade'] .h-section,
  .fork[data-bg='sage'] .h-section {
    color: var(--color-on-dark);
  }
  .fork[data-bg='shade'] .hand,
  .fork[data-bg='sage'] .hand {
    color: var(--color-blush);
  }
  /* полоса навеса сверху и снизу, фон остаётся песочным */
  .fork[data-bg='awning']::before,
  .fork[data-bg='awning']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 14px;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-red) 0 14px,
      var(--color-cream) 14px 28px
    );
  }
  .fork[data-bg='awning']::before {
    top: 0;
  }
  .fork[data-bg='awning']::after {
    bottom: 0;
  }

  .door {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    border: 0;
    border-radius: calc(var(--radius-block) * 0.82);
    padding: 24px 26px 26px;
    background: var(--color-cream);
    display: grid;
    gap: 6px;
    align-content: start;
    position: relative;
    overflow: hidden;
    transition:
      background-color calc(0.35s * var(--motion)) var(--ease),
      color calc(0.35s * var(--motion)) var(--ease),
      transform calc(0.35s * var(--motion)) var(--ease);
  }
  .door:hover {
    transform: translateY(-3px);
  }
  .door h3 {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
  }
  .door p {
    font-size: 15px;
    color: var(--color-muted);
    max-width: 30ch;
  }
  .door :global(.door-icon) {
    width: 34px;
    height: 34px;
    color: var(--color-red);
    margin-bottom: 10px;
    transition: color 0.35s var(--ease-out-expo);
  }
  .door[aria-selected='true'] {
    background: var(--color-red);
    color: #fff;
  }
  .door[aria-selected='true'] p {
    color: #fbe3dc;
  }
  .door[aria-selected='true'] :global(.door-icon) {
    color: #fff;
  }
  .door[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-cream) 0 22px,
      transparent 22px 38px,
      var(--color-coffee) 38px 52px,
      transparent 52px 68px
    );
  }

  .panel {
    margin-top: 12px;
    background: var(--color-cream);
    border-radius: var(--radius-block);
    padding: 22px;
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 26px;
    align-items: start;
  }
  /* «Прийти»: слева фото и схема столиков, справа заголовок, зона и форма столбиком —
     колонки близки по высоте, пустот нет */
  .panel-visit {
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
  }
  .v-col {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .v-zone :global(legend),
  .v-tables :global(legend) {
    margin-bottom: 6px;
  }
  .panel-visit .fields {
    margin-top: 0;
  }
  .panel-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.05;
    text-wrap: balance;
  }
  .panel-sub {
    color: var(--color-muted);
    margin-top: 8px;
    max-width: 52ch;
    font-size: 15px;
  }
  .facts {
    margin-top: 16px;
    border-top: 1px solid var(--color-line);
  }
  .facts li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 14px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 14.5px;
  }
  .facts span {
    color: var(--color-muted);
  }
  .textlink {
    font-weight: 500;
    color: var(--color-coffee);
    display: inline-block;
    margin-top: 14px;
  }
  .textlink:hover {
    color: var(--color-red);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-top: 16px;
  }
  .fields > * {
    grid-column: span 3;
  }
  /* адрес длинный, время короткое: одной строкой */
  .fields .address {
    grid-column: span 4;
  }
  .fields .when {
    grid-column: span 2;
  }
  .time-hint {
    margin-top: -6px;
    font-size: 13px;
    color: var(--color-muted);
  }
  .wide {
    grid-column: 1 / -1;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .seg {
    display: inline-flex;
    background: var(--color-linen);
    border-radius: 999px;
    padding: 5px;
    gap: 5px;
    width: max-content;
    max-width: 100%;
  }
  .seg label {
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .seg span {
    display: block;
    font: 500 15px/1 var(--font-sans);
    color: var(--color-ink);
    padding: 12px 20px;
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease-out-expo),
      color 0.25s var(--ease-out-expo);
  }
  .seg input:checked + span {
    background: var(--color-red);
    color: #fff;
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }
  .seg small {
    display: block;
    margin-top: 5px;
    font-size: 12.5px;
    font-weight: 400;
    opacity: 0.75;
  }

  /* мини-схема брони: квадрат средней величины, столики — круглые кнопки */
  .tables-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }
  .plan {
    position: relative;
    width: min(100%, 260px);
    aspect-ratio: 1;
    display: grid;
    grid-template: repeat(5, 1fr) / repeat(5, 1fr);
    place-items: center;
    padding: 12px;
    border-radius: 18px;
    background: var(--color-linen);
    box-shadow: inset 0 0 0 2px var(--color-line);
  }
  .plan[hidden] {
    display: none;
  }
  .counter {
    grid-row: 1;
    grid-column: 1 / 4;
    align-self: start;
    justify-self: stretch;
    padding: 5px 0;
    border-radius: 8px;
    background: var(--color-coffee);
    color: var(--color-cream);
    font-size: 11.5px;
    text-align: center;
  }
