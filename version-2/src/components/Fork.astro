  .summary-list {
    margin-top: 8px;
  }
  .summary-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 14.5px;
  }
  .summary-list b {
    flex: none;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .summary-total {
    margin-top: 8px;
    font-weight: 600;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .summary-total[hidden],
  .summary-empty[hidden],
  .summary-error[hidden] {
    display: none;
  }
  .summary-empty {
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .summary-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .summary-error {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-red-ink);
  }
  .ok-number {
    margin-top: 14px;
    font: 400 22px/1.2 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .ok .summary-list {
    max-width: 420px;
  }
  .kept {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
  }
  .forget {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .forget:hover {
    color: var(--color-red-ink);
  }
  .ok h4 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.1;
  }
  .ok p {
    color: var(--color-muted);
    margin-top: 8px;
    max-width: 44ch;
  }

  /* Планшет: фото и текст остаются в две колонки — в одну колонку фото на всю ширину
     выходило огромным (квадратный кадр ~900 px в высоту) */
  @media (max-width: 980px) {
    .panel {
      grid-template-columns: 0.8fr 1.2fr;
      padding: 18px;
      gap: 20px;
    }
    /* «Прийти» на планшете остаётся в две колонки: так блок вдвое ниже */
    .panel-visit {
      grid-template-columns: 1fr 1fr;
      column-gap: 20px;
    }
  }
  @media (max-width: 720px) {
    .panel {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  @media (max-width: 720px) {
    /* одна колонка: колонки раскрываются, порядок — фото, заголовок, зона, схема, форма */
    .panel-visit {
      grid-template-columns: 1fr;
    }
    .panel-visit .v-col {
      display: contents;
    }
    .panel-visit > .v-col > :global(figure) {
      order: 1;
    }
    .v-head {
      order: 2;
    }
    .v-zone {
      order: 3;
    }
    .v-tables {
      order: 4;
    }
    .v-form {
      order: 5;
    }
  }

  @media (max-width: 720px) {
    .doors {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .door {
      padding: 18px 20px;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      align-items: center;
    }
    .door :global(.door-icon) {
      margin: 0;
      grid-row: span 2;
      width: 30px;
      height: 30px;
    }
    .door h3 {
      font-size: 28px;
    }
  }
  @media (max-width: 640px) {
    .fields > *,
    .fields .address,
    .fields .when {
      grid-column: 1 / -1;
    }
    .facts li {
      grid-template-columns: 110px 1fr;
    }
    .panel {
      border-radius: 26px;
      padding: 20px;
    }
    .seg span {
      padding: 11px 16px;
    }
    .plan {
      width: min(100%, 240px);
    }
    .table span {
      width: 36px;
      height: 36px;
