---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { cafe, menuGroups, type MenuItem } from '../data/cafe';
import type { Dict } from '../i18n/ru';
import icedAmericano from '../../../references/для меню/iced-americano.jpg';
import icedLatte from '../../../references/для меню/iced-latte.jpg';
import icedSpanishLatte from '../../../references/для меню/iced-spanish-latte.jpg';
import icedMatchaLatte from '../../../references/для меню/iced-matcha-latte.jpg';
import icedMatchaSpanishLatte from '../../../references/для меню/iced-matcha-spanish-latte.jpg';
import savvaIcedTea from '../../../references/для меню/savva-iced-tea.jpg';
import iceShaken from '../../../references/для меню/ice-shaken.jpg';
import icedWhiteMocha from '../../../references/для меню/iced-white-mocha.jpg';
import icedChocolate from '../../../references/для меню/iced-chocolate.jpg';
import espresso from '../../../references/для меню/espresso.jpg';
import americano from '../../../references/для меню/americano.jpg';
import cortado from '../../../references/для меню/cortado.jpg';
import macchiato from '../../../references/для меню/macchiato.jpg';
import flatWhite from '../../../references/для меню/flat-white.jpg';
import latte from '../../../references/для меню/latte.jpg';
import spanishLatte from '../../../references/для меню/spanish-latte.jpg';
import matchaLatte from '../../../references/для меню/matcha-latte.jpg';
import whiteMocha from '../../../references/для меню/white-mocha.jpg';
import englishTea from '../../../references/для меню/english-tea.jpg';
import turkishCoffee from '../../../references/для меню/turkish-coffee.jpg';
import turkishCoffeeMilk from '../../../references/для меню/turkish-coffee-milk.jpg';
import coffeeOfDay from '../../../references/для меню/coffee-of-day.jpg';
import dripCoffee from '../../../references/для меню/drip-coffee.jpg';
import marbleCake from '../../../references/для меню/marble-cake.jpg';
import crunchyChocolate from '../../../references/для меню/crunchy-chocolate.jpg';
import turkeySandwich from '../../../references/для меню/turkey-sandwich.jpg';
import savvaMatcha from '../../../references/для меню/матча савва.png';
import hotChocolate from '../../../references/для меню/горячий шоколад.png';
import alfredo from '../../../references/для меню/alfredo.png';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.calm;
const m = t.menu;
const k = t.cart;

// Фото позиций: общие кадры кафе, реальные фото меню и финальные AI-композиции из references
const files = import.meta.glob<{ default: ImageMetadata }>(['../assets/photos/*.jpg', '../assets/menu/*.jpg'], { eager: true });
const menuFiles: Record<string, ImageMetadata> = {
  'iced-americano': icedAmericano,
  'iced-latte': icedLatte,
  'iced-spanish-latte': icedSpanishLatte,
  'iced-matcha-latte': icedMatchaLatte,
  'iced-matcha-spanish-latte': icedMatchaSpanishLatte,
  'savva-iced-tea': savvaIcedTea,
  'ice-shaken': iceShaken,
  'iced-white-mocha': icedWhiteMocha,
  'iced-chocolate': icedChocolate,
  espresso,
  americano,
  cortado,
  macchiato,
  'flat-white': flatWhite,
  latte,
  'spanish-latte': spanishLatte,
  'matcha-latte': matchaLatte,
  'white-mocha': whiteMocha,
  'english-tea': englishTea,
  'turkish-coffee': turkishCoffee,
  'turkish-coffee-milk': turkishCoffeeMilk,
  'coffee-of-day': coffeeOfDay,
  'drip-coffee': dripCoffee,
  'marble-cake': marbleCake,
  'crunchy-chocolate': crunchyChocolate,
  'turkey-sandwich': turkeySandwich,
  'savva-matcha': savvaMatcha,
  'hot-chocolate': hotChocolate,
  alfredo,
};
const byName = new Map([
  ...Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.replace('.jpg', ''), mod.default] as const),
  ...Object.entries(menuFiles),
]);

const photoOf = async (item: MenuItem) => {
  const src = item.photo ? byName.get(item.photo) : undefined;
  if (!src) return undefined;
  const [small, large] = await Promise.all([
    getImage({ src, width: 320, format: 'webp' }),
    getImage({ src, width: 520, format: 'webp' }),
  ]);
  return { small: small.src, large: large.src };
};

const groups = await Promise.all(
  menuGroups.map(async (g) => ({
    ...g,
    cards: await Promise.all(g.items.map(async (item) => ({ item, photo: await photoOf(item) }))),
  })),
);
---

<section class="menu" id="menu" data-menu>
  <div class="wrap">
    <div class="intro">
      <p class="hand text-blush!">{c.hand}</p>
      <h2 class="h-section text-on-dark">{c.title}</h2>
      <div class="facts">
        <a class="fact" href="#reviews" aria-label={`${cafe.reviewTopics.atmosphere} ${c.atmosphere}. Перейти к отзывам`}>
          <b>{cafe.reviewTopics.atmosphere}</b> {c.atmosphere}
        </a>
      </div>
    </div>

    <!-- полка: слева меню, группы и стрелки, справа лента уходит до края плашки -->
    <div class="shelf">
      <div class="side">
        <h3 class="title">{m.title}</h3>
        <div class="groups-shell">
          <div class="groups" id="menu-groups" role="tablist" aria-label={m.tabsLabel}>
            {
              groups.map((g, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`menu-tab-${g.id}`}
                  aria-controls={`menu-${g.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-group={g.id}
                >
                  {m.groups[g.id]}
                </button>
              ))
            }
          </div>
          <div
            class="horizontal-scrollbar menu-scrollbar groups-scrollbar"
            role="scrollbar"
            tabindex="0"
            aria-label="Прокрутка категорий меню"
            aria-controls="menu-groups"
            aria-orientation="horizontal"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-horizontal-scrollbar
            data-scroll-target="menu-groups"
          >
            <span class="horizontal-scroll-thumb" data-horizontal-scroll-thumb></span>
          </div>
        </div>
        <div class="arrows">
          <button type="button" class="arrow" data-step="-1" aria-label={m.prev}>
            <Icon name="arrow" class="back" />
          </button>
          <button type="button" class="arrow" data-step="1" aria-label={m.next}>
            <Icon name="arrow" />
          </button>
        </div>
        <p class="note">{m.note}</p>
      </div>

      <div class="stage">
        {
          groups.map((g, i) => (
            <>
              <ul class="track" role="tabpanel" id={`menu-${g.id}`} aria-labelledby={`menu-tab-${g.id}`} tabindex="0" hidden={i !== 0}>
                {g.cards.map(({ item, photo }) => (
                  <li class="card">
                  <div class="shot">
                    {photo ? (
                      <img
                        src={photo.large}
                        srcset={`${photo.small} 320w, ${photo.large} 520w`}
                        sizes="(max-width: 640px) 44vw, (max-width: 1023px) 28vw, 16vw"
                        alt={item.ru}
                        loading="lazy"
                        decoding="async"
                        style={item.focus ? `object-position:${item.focus}` : undefined}
                      />
                    ) : (
                      <span class="plate">
                        <span class="plate-ar" lang="ar" dir="rtl">{item.ar}</span>
                        <span class="plate-note">{m.noPhoto}</span>
                      </span>
                    )}
                    {item.price !== undefined || item.priceText ? (
                      <span class="price">
                        <b>{item.price ?? item.priceText}</b>
                        <span>{m.currency}</span>
                      </span>
                    ) : null}
                  </div>
                  <p class="name">{item.ru}</p>
                  <p class="kcal">
                    {item.kcal !== undefined ? `${item.kcal} ${m.kcal}` : item.price === undefined && !item.priceText ? m.askPrice : ' '}
                  </p>
                  <div class="qty" data-qty={item.id}>
                    <button type="button" class="add" data-add aria-label={`${k.add}: ${item.ru}`}>{k.add}</button>
                    <div class="stepper" data-stepper hidden>
                      <button type="button" data-step-qty="-1" aria-label={`${k.removeOne}: ${item.ru}`}>
                        <Icon name="minus" />
                      </button>
                      <output data-count aria-live="polite">0</output>
                      <button type="button" data-step-qty="1" aria-label={`${k.addOne}: ${item.ru}`}>
                        <Icon name="plus" />
                      </button>
                    </div>
                  </div>
                  </li>
                ))}
              </ul>
              <div
                class="horizontal-scrollbar menu-scrollbar"
                role="scrollbar"
                tabindex="0"
                aria-label={`Прокрутка меню «${m.groups[g.id]}»`}
                aria-controls={`menu-${g.id}`}
                aria-orientation="horizontal"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-horizontal-scrollbar
                data-scroll-target={`menu-${g.id}`}
              >
                <span class="horizontal-scroll-thumb" data-horizontal-scroll-thumb></span>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Синяя плашка: сверху атмосфера (заголовок и числа из отзывов), ниже полка меню */
  .menu {
    --gap: 12px;
    --per-view: 2.2;
    --gutter: clamp(20px, var(--wrap-gutter), 40px);
    background: var(--color-shade);
    color: var(--color-on-dark);
    border-radius: calc(var(--radius-block) * 1.1);
    /* плашка шириной с контент страницы — края на одной линии с панелью развилки над ней */
    /* --menu-widen: насколько плашка шире (плюс) или уже (минус) колонки контента с каждой стороны */
    /* до края экрана всегда остаётся --menu-edge-min */
    width: min(calc(100% - 2 * var(--menu-edge-min)), calc(100% - 2 * var(--gutter) + 2 * var(--menu-widen)));
    max-width: calc(var(--wrap-max) - 2 * var(--gutter) + 2 * var(--menu-widen));
    margin-inline: auto;
    padding-block: var(--menu-pad-top) var(--block-pad);
    overflow: hidden;
  }
  /* зазор до развилки своей ручкой, а не общим ритмом блоков: между двумя цветными
     плашками общий ритм давал случайную полосу фона */
  :global(main) > .menu {
    margin-top: var(--menu-gap);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    min-height: 44px;
    border: 1.5px solid rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 14.5px;
    color: var(--color-on-dark-soft);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out-expo),
      background-color 0.2s var(--ease-out-expo);
  }
  .fact:hover {
    border-color: var(--color-on-dark);
    background: rgb(247 239 224 / 0.08);
  }
  .fact b {
    color: var(--color-on-dark);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Телефон и планшет: заголовок, группы, лента, стрелки, пояснение — столбиком */
  .shelf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'groups' 'stage' 'arrows' 'note';
    margin-top: clamp(40px, 6vw, 64px);
  }
  .side {
    display: contents;
  }
  .title {
    grid-area: title;
    font: 400 clamp(34px, 4vw, 52px) / 1 var(--font-display);
  }
  .groups-shell {
    grid-area: groups;
    min-width: 0;
    margin-top: 18px;
  }
  .groups {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .groups button {
    font: 500 15px/1 var(--font-sans);
    color: var(--color-on-dark);
    background: transparent;
    border: 0;
    box-shadow: inset 0 0 0 1.5px rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 12px 18px;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out-expo),
      box-shadow 0.25s var(--ease-out-expo);
  }
  .groups button:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-on-dark);
  }
  .groups button[aria-selected='true'] {
    background: var(--color-red);
    box-shadow: none;
    color: #fff;
  }
  .stage {
    grid-area: stage;
    min-width: 0;
    margin-top: 24px;
  }
  .arrows {
    grid-area: arrows;
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
  }
  .note {
    grid-area: note;
    margin-top: 20px;
    max-width: 60ch;
    font-size: 13.5px;
    color: var(--color-on-dark-soft);
  }

  /* Лента: карточки в ряд, листается пальцем, трекпадом и стрелками.
     Тонкий индикатор повторяет поведение ленты отзывов: мышью видно, что
     полка продолжается, а на сенсорных экранах остаётся привычный свайп. */
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track[hidden] {
    display: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .menu-scrollbar {
    --horizontal-scroll-track: rgb(247 239 224 / 0.18);
    --horizontal-scroll-thumb: var(--color-blush);
    --horizontal-scroll-focus: var(--color-blush);
  }
  .track:focus-visible {
    outline: 2px solid var(--color-blush);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .card {
    scroll-snap-align: start;
    min-width: 0;
  }
  /* квадратный кадр; ценник-бирка висит под ним и лишь краем заходит на фото */
  .shot {
    position: relative;
    aspect-ratio: 1;
  }
  .shot img,
  .plate {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-tile);
    object-fit: cover;
  }
  /* нет фото: шалфейная плашка с арабским названием из меню кафе */
  .plate {
    display: grid;
    place-content: center;
    gap: 8px;
    padding: 14px;
    text-align: center;
    background: var(--color-sage);
  }
  .plate-ar {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.25;
    color: var(--color-cream);
  }
  .plate-note {
    font-size: 12px;
    color: rgb(247 239 224 / 0.7);
  }
  .price {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
    transform: translate(-50%, 78%);
    box-shadow: 0 0 0 3px var(--color-shade);
  }
  .price b {
    font: 600 18px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .price span {
    font: 500 10.5px/1 var(--font-sans);
    letter-spacing: 0.04em;
  }
  .name {
    margin-top: 32px;
    font-size: 15.5px;
    line-height: 1.3;
    text-align: center;
  }
  .kcal {
    margin-top: 2px;
    min-height: 1.4em;
    font-size: 12.5px;
    text-align: center;
    color: var(--color-on-dark-soft);
    font-variant-numeric: tabular-nums;
  }

  /* стрелки как у галерей развилки: кремовый круг, та же стрелка */
  /* «В заказ» и счётчик под карточкой; корзина — в src/scripts/cart.ts */
  .qty {
    display: flex;
    justify-content: center;
    margin-top: 10px;
    min-height: 38px;
  }
  .add {
    font: 500 14px/1 var(--font-sans);
    color: var(--color-on-dark);
    background: transparent;
    border: 0;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px rgb(247 239 224 / 0.45);
    padding: 11px 18px;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out-expo),
      box-shadow 0.2s var(--ease-out-expo);
  }
  .add:hover {
    background: var(--color-red);
    box-shadow: none;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .stepper[hidden] {
    display: none;
  }
  .stepper button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--color-cream);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo);
  }
  .stepper button:hover {
    background: var(--color-red);
    color: #fff;
  }
  .stepper :global(svg) {
    width: 18px;
    height: 18px;
  }
  .stepper output {
    min-width: 2ch;
    text-align: center;
    font: 600 18px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .add:focus-visible,
  .stepper button:focus-visible {
    outline: 2px solid var(--color-blush);
    outline-offset: 3px;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--color-cream);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      opacity 0.25s var(--ease-out-expo);
  }
  .arrow:hover {
    background: var(--color-red);
    color: #fff;
  }
  .arrow:focus-visible {
    outline: 2px solid var(--color-blush);
    outline-offset: 3px;
  }
  .arrow[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }
  .arrow[aria-disabled='true']:hover {
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .arrow :global(svg) {
    width: 22px;
    height: 22px;
  }
  .arrow :global(.back) {
    transform: scaleX(-1);
  }

  @media (min-width: 641px) {
    .menu {
      --per-view: 3.3;
    }
  }
  /* Монитор: слева меню, группы, стрелки; справа лента до края плашки, последняя карточка обрезана */
  @media (min-width: 1024px) {
    .menu {
      --per-view: 4.4;
    }
    .shelf {
      grid-template-columns: minmax(230px, 0.8fr) minmax(0, 2.8fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: 'title stage' 'groups stage' 'arrows stage' 'note stage';
      column-gap: 48px;
    }
    .stage {
      margin-top: 0;
      margin-inline-end: calc(-1 * var(--gutter));
    }
    .groups-shell { margin-top: 22px; }
    .arrows {
      justify-content: flex-start;
      margin-top: 26px;
    }
    .note {
      align-self: end;
      font-size: 13px;
    }
  }

  /* Телефон и планшет: категории остаются одной свайпаемой строкой и явно
     показывают горизонтальный скроллбар, как лента отзывов. */
  @media (max-width: 1023px) {
    .groups-shell {
      margin-inline: calc(-1 * var(--gutter));
    }
    .groups {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .groups::-webkit-scrollbar { display: none; }
    .groups-scrollbar { margin-inline: var(--gutter); }
    .groups button {
      flex: none;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 640px) {
    .menu {
      border-radius: 26px;
    }
  }
</style>

<script>
  import { changeQty, onCart, qtyOf } from '../scripts/cart';
  import { bindHorizontalScrollbars } from '../scripts/horizontal-scrollbar';

  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-group]')];
    const arrows = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const current = () => root.querySelector<HTMLElement>('.track:not([hidden])');

    // Стрелка у края ленты гаснет
    const sync = () => {
      const track = current();
      if (!track) return;
      const pos = Math.abs(track.scrollLeft);
      const end = track.scrollWidth - track.clientWidth - 2;
      arrows.forEach((b) => {
        const off = Number(b.dataset.step) < 0 ? pos <= 2 : pos >= end;
        b.setAttribute('aria-disabled', String(off));
      });
    };

    arrows.forEach((b) =>
      b.addEventListener('click', () => {
        const track = current();
        if (!track || b.getAttribute('aria-disabled') === 'true') return;
        const rtl = getComputedStyle(track).direction === 'rtl';
        // листаем на ширину видимых карточек
        const step = Number(b.dataset.step) * track.clientWidth * (rtl ? -1 : 1);
        track.scrollBy({ left: step, behavior: calm.matches ? 'auto' : 'smooth' });
      }),
    );

    function select(tab: HTMLButtonElement) {
      tabs.forEach((b) => {
        const on = b === tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const track = document.getElementById(`menu-${b.dataset.group}`)!;
        track.hidden = !on;
        if (on) track.scrollLeft = 0;
      });
      sync();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });

    // Корзина: «В заказ» превращается в счётчик; одна позиция может стоять в двух группах — обновляем все
    const paint = () =>
      root.querySelectorAll<HTMLElement>('[data-qty]').forEach((box) => {
        const qty = qtyOf(box.dataset.qty!);
        box.querySelector<HTMLElement>('[data-add]')!.hidden = qty > 0;
        box.querySelector<HTMLElement>('[data-stepper]')!.hidden = qty === 0;
        box.querySelector('[data-count]')!.textContent = String(qty);
      });
    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const box = target.closest<HTMLElement>('[data-qty]');
      if (!box) return;
      const id = box.dataset.qty!;
      if (target.closest('[data-add]')) {
        changeQty(id, 1);
        // кнопка «В заказ» пропала — фокус на «+», чтобы с клавиатуры не терялось место
        box.querySelector<HTMLButtonElement>('[data-step-qty="1"]')?.focus();
        return;
      }
      const step = target.closest<HTMLElement>('[data-step-qty]');
      if (step) {
        changeQty(id, Number(step.dataset.stepQty));
        if (qtyOf(id) === 0) box.querySelector<HTMLButtonElement>('[data-add]')?.focus();
      }
    });
    onCart(paint);
    paint();

    root.querySelectorAll('.track').forEach((t) => t.addEventListener('scroll', sync, { passive: true }));
    addEventListener('resize', sync);
    sync();
    bindHorizontalScrollbars(root);
  }
</script>
