---
import { getImage } from 'astro:assets';
import { cafe, menuGroups, type MenuItem } from '../data/cafe';
import type { Dict } from '../i18n/ru';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const c = t.calm;
const m = t.menu;

// Фото позиций: общие кадры кафе и кадры, вырезанные из сторис меню
const files = import.meta.glob<{ default: ImageMetadata }>(['../assets/photos/*.jpg', '../assets/menu/*.jpg'], { eager: true });
const byName = new Map(Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.replace('.jpg', ''), mod.default]));

const photoOf = async (item: MenuItem) => {
  const src = item.photo ? byName.get(item.photo) : undefined;
  if (!src) return undefined;
  const [small, large] = await Promise.all([
    getImage({ src, width: 320, format: 'webp' }),
    getImage({ src, width: 520, format: 'webp' }),
  ]);
  return { small: small.src, large: large.src };
};

const groups = await Promise.all(
  menuGroups.map(async (g) => ({
    ...g,
    cards: await Promise.all(g.items.map(async (item) => ({ item, photo: await photoOf(item) }))),
  })),
);
---

<section class="menu" id="menu" data-menu>
  <div class="wrap">
    <div class="intro">
      <p class="hand text-blush!">{c.hand}</p>
      <h2 class="h-section text-on-dark">{c.title}</h2>
      <div class="facts">
        <span class="fact"><b>{cafe.reviewTopics.quietness}</b> {c.quietness}</span>
        <span class="fact"><b>{cafe.reviewTopics.outdoorSeating}</b> {c.terrace}</span>
      </div>
    </div>

    <!-- полка: слева меню, группы и стрелки, справа лента уходит до края плашки -->
    <div class="shelf">
      <div class="side">
        <h3 class="title">{m.title}</h3>
        <div class="groups" role="tablist" aria-label={m.tabsLabel}>
          {
            groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`menu-tab-${g.id}`}
                aria-controls={`menu-${g.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-group={g.id}
              >
                {m.groups[g.id]}
              </button>
            ))
          }
        </div>
        <div class="arrows">
          <button type="button" class="arrow" data-step="-1" aria-label={m.prev}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="arrow" data-step="1" aria-label={m.next}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <p class="note">{m.note}</p>
      </div>

      <div class="stage">
        {
          groups.map((g, i) => (
            <ul class="track" role="tabpanel" id={`menu-${g.id}`} aria-labelledby={`menu-tab-${g.id}`} tabindex="0" hidden={i !== 0}>
              {g.cards.map(({ item, photo }) => (
                <li class="card">
                  <div class="shot">
                    {photo ? (
                      <img
                        src={photo.large}
                        srcset={`${photo.small} 320w, ${photo.large} 520w`}
                        sizes="(max-width: 640px) 44vw, (max-width: 1023px) 28vw, 16vw"
                        alt={item.ru}
                        loading="lazy"
                        decoding="async"
                        style={item.focus ? `object-position:${item.focus}` : undefined}
                      />
                    ) : (
                      <span class="plate">
                        <span class="plate-ar" lang="ar" dir="rtl">{item.ar}</span>
                        <span class="plate-note">{m.noPhoto}</span>
                      </span>
                    )}
                    {item.price !== undefined || item.priceText ? (
                      <span class="price">
                        <b>{item.price ?? item.priceText}</b>
                        <span>{m.currency}</span>
                      </span>
                    ) : null}
                  </div>
                  <p class="name">{item.ru}</p>
                  <p class="kcal">
                    {item.kcal !== undefined ? `${item.kcal} ${m.kcal}` : item.price === undefined && !item.priceText ? m.askPrice : ' '}
                  </p>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Синяя плашка: сверху атмосфера (заголовок и числа из отзывов), ниже полка меню */
  .menu {
    --gap: 12px;
    --per-view: 2.2;
    --gutter: clamp(20px, var(--wrap-gutter), 40px);
    background: var(--color-shade);
    color: var(--color-on-dark);
    border-radius: calc(var(--radius-block) * 1.1);
    margin-inline: 14px;
    padding-block: var(--block-pad);
    overflow: hidden;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .fact {
    border: 1.5px solid rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 14.5px;
    color: var(--color-on-dark-soft);
  }
  .fact b {
    color: var(--color-on-dark);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Телефон и планшет: заголовок, группы, лента, стрелки, пояснение — столбиком */
  .shelf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'groups' 'stage' 'arrows' 'note';
    margin-top: clamp(40px, 6vw, 64px);
  }
  .side {
    display: contents;
  }
  .title {
    grid-area: title;
    font: 400 clamp(34px, 4vw, 52px) / 1 var(--font-display);
  }
  .groups {
    grid-area: groups;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .groups button {
    font: 500 15px/1 var(--font-sans);
    color: var(--color-on-dark);
    background: transparent;
    border: 0;
    box-shadow: inset 0 0 0 1.5px rgb(247 239 224 / 0.4);
    border-radius: 999px;
    padding: 12px 18px;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out-expo),
      box-shadow 0.25s var(--ease-out-expo);
  }
  .groups button:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-on-dark);
  }
  .groups button[aria-selected='true'] {
    background: var(--color-red);
    box-shadow: none;
    color: #fff;
  }
  .stage {
    grid-area: stage;
    min-width: 0;
    margin-top: 24px;
  }
  .arrows {
    grid-area: arrows;
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
  }
  .note {
    grid-area: note;
    margin-top: 20px;
    max-width: 60ch;
    font-size: 13.5px;
    color: var(--color-on-dark-soft);
  }

  /* лента: карточки в ряд, листается пальцем, колесом и стрелками */
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track[hidden] {
    display: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--color-blush);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .card {
    scroll-snap-align: start;
    min-width: 0;
  }
  /* квадратный кадр; ценник-бирка висит под ним и лишь краем заходит на фото */
  .shot {
    position: relative;
    aspect-ratio: 1;
  }
  .shot img,
  .plate {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-tile);
    object-fit: cover;
  }
  /* нет фото: шалфейная плашка с арабским названием из меню кафе */
  .plate {
    display: grid;
    place-content: center;
    gap: 8px;
    padding: 14px;
    text-align: center;
    background: var(--color-sage);
  }
  .plate-ar {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.25;
    color: var(--color-cream);
  }
  .plate-note {
    font-size: 12px;
    color: rgb(247 239 224 / 0.7);
  }
  .price {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--color-red);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
    transform: translate(-50%, 78%);
    box-shadow: 0 0 0 3px var(--color-shade);
  }
  .price b {
    font: 600 18px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }
  .price span {
    font: 500 10.5px/1 var(--font-sans);
    letter-spacing: 0.04em;
  }
  .name {
    margin-top: 32px;
    font-size: 15.5px;
    line-height: 1.3;
    text-align: center;
  }
  .kcal {
    margin-top: 2px;
    min-height: 1.4em;
    font-size: 12.5px;
    text-align: center;
    color: var(--color-on-dark-soft);
    font-variant-numeric: tabular-nums;
  }

  .arrow {
    display: grid;
    place-content: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px rgb(247 239 224 / 0.45);
    color: var(--color-on-dark);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out-expo),
      opacity 0.25s var(--ease-out-expo);
  }
  .arrow:hover {
    background: rgb(247 239 224 / 0.12);
  }
  .arrow:focus-visible {
    outline: 2px solid var(--color-blush);
    outline-offset: 3px;
  }
  .arrow[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }
  .arrow svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 641px) {
    .menu {
      --per-view: 3.3;
    }
  }
  /* Монитор: слева меню, группы, стрелки; справа лента до края плашки, последняя карточка обрезана */
  @media (min-width: 1024px) {
    .menu {
      --per-view: 4.4;
    }
    .shelf {
      grid-template-columns: minmax(230px, 0.8fr) minmax(0, 2.8fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: 'title stage' 'groups stage' 'arrows stage' 'note stage';
      column-gap: 48px;
    }
    .stage {
      margin-top: 0;
      margin-inline-end: calc(-1 * var(--gutter));
    }
    .groups {
      margin-top: 22px;
    }
    .arrows {
      justify-content: flex-start;
      margin-top: 26px;
    }
    .note {
      align-self: end;
      font-size: 13px;
    }
  }

  @media (max-width: 640px) {
    .menu {
      margin-inline: 8px;
      border-radius: 26px;
    }
    .groups {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .groups::-webkit-scrollbar {
      display: none;
    }
    .groups button {
      flex: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-group]')];
    const arrows = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const current = () => root.querySelector<HTMLElement>('.track:not([hidden])');

    // Стрелка у края ленты гаснет
    const sync = () => {
      const track = current();
      if (!track) return;
      const pos = Math.abs(track.scrollLeft);
      const end = track.scrollWidth - track.clientWidth - 2;
      arrows.forEach((b) => {
        const off = Number(b.dataset.step) < 0 ? pos <= 2 : pos >= end;
        b.setAttribute('aria-disabled', String(off));
      });
    };

    arrows.forEach((b) =>
      b.addEventListener('click', () => {
        const track = current();
        if (!track || b.getAttribute('aria-disabled') === 'true') return;
        const rtl = getComputedStyle(track).direction === 'rtl';
        // листаем на ширину видимых карточек
        const step = Number(b.dataset.step) * track.clientWidth * (rtl ? -1 : 1);
        track.scrollBy({ left: step, behavior: calm.matches ? 'auto' : 'smooth' });
      }),
    );

    function select(tab: HTMLButtonElement) {
      tabs.forEach((b) => {
        const on = b === tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const track = document.getElementById(`menu-${b.dataset.group}`)!;
        track.hidden = !on;
        if (on) track.scrollLeft = 0;
      });
      sync();
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });

    root.querySelectorAll('.track').forEach((t) => t.addEventListener('scroll', sync, { passive: true }));
    addEventListener('resize', sync);
    sync();
  }
</script>
